# Maintainer: Bruno Goncalves <bigbruno@gmail.com>
# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=debtap-mod
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL-2.0-or-later')
url="https://github.com/biglinux/debtap-mod"
pkgdesc="Convert and install .deb packages (GTK4 + libadwaita interface)"
source=("git+https://github.com/biglinux/debtap-mod.git")
md5sums=(SKIP)
depends=(
    'pacman'          # makepkg, pacman, vercmp, pacman-conf
    'fakeroot'
    'zstd'
    'libarchive'      # bsdtar, used by makepkg
    'polkit'          # pkexec
    'python>=3.14'
    'python-gobject'
    'gtk4'
    'libadwaita'
)
optdepends=('pamac-gtk: open native packages suggested by the installer')
checkdepends=('python-pytest')

check() {
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        cd "${srcdir}/${pkgname}/${pkgname}"
    else
        cd "${srcdir}/${pkgname}"
    fi
    PYTHONDONTWRITEBYTECODE=1 pytest -q -p no:cacheprovider -m "not slow"
}

package() {
    # Verify default folder
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}/${pkgname}"
    else
        InternalDir="${srcdir}/${pkgname}"
    fi

    # Copy files
    if [ -d "${InternalDir}/usr" ]; then
        cp -a "${InternalDir}/usr" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/etc" ]; then
        cp -a "${InternalDir}/etc" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/opt" ]; then
        cp -a "${InternalDir}/opt" "${pkgdir}/"
    fi

    find "${pkgdir}" -name '__pycache__' -type d -prune -exec rm -rf {} +
}
