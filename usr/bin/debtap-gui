#!/bin/bash
# Graphical installer for .deb packages (GTK4 + libadwaita).
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
APP_DIR="$SCRIPT_DIR/../share/debtap-mod"
[[ -d "$APP_DIR/debtap_mod" ]] || APP_DIR="/usr/share/debtap-mod"
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec -a debtap-gui python3 -m debtap_mod.gui "$@"
