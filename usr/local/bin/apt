#!/bin/bash
# Translate apt/dnf/dpkg commands into pacman/pamac (see "apt help").
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
APP_DIR="$SCRIPT_DIR/../../share/big-pkg-installer"
[[ -d "$APP_DIR/big_pkg_installer" ]] || APP_DIR="/usr/share/big-pkg-installer"
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m big_pkg_installer.pkgcompat "$(basename "$0")" "$@"
