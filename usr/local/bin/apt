#!/bin/bash
# Translate apt/dnf/dpkg commands into pacman/pamac (see "apt help").
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
APP_DIR="$SCRIPT_DIR/../../share/debtap-mod"
[[ -d "$APP_DIR/debtap_mod" ]] || APP_DIR="/usr/share/debtap-mod"
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m debtap_mod.pkgcompat "$(basename "$0")" "$@"
