msgstr "makepkg lõpetas, kuid ei loonud ühtegi paketti"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "“{typed}” värskendab ainult paketiloendit. Siin kontrollib turvaline vaste uuendusi, installimata midagi; nende paigaldamiseks kasuta “{upgrade}”."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Ära kunagi käivita ainult “pacman -Sy”: loendi värskendamine ilma süsteemi uuendamata võib süsteemi rikkuda."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch ei uuenda üksikuid pakette; kogu süsteemi uuendatakse korraga."

msgid "Tell which package to install, for example: {example}"
msgstr "Ütle, milline pakett paigaldada, näiteks: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac leiab programme ka AUR-ist ja Flatpakist: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by debtap-mod."
msgstr "debtap-mod teisendab .deb- ja .rpm-paketid natiivseteks pacmani pakettideks."

msgid "Run this command as a regular user (without sudo)."
msgstr "Käivita see käsk tavakasutajana (ilma sudota)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Ütle, milline pakett eemaldada, näiteks: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n kustutab ka seadistusfailid, mille pakett kausta /etc paigaldas."

msgid "There are no orphan packages to remove."
msgstr "Eemaldatavaid orbpakette pole."

msgid "Tell what to search for, for example: {example}"
msgstr "Ütle, mida otsida, näiteks: {example}"

