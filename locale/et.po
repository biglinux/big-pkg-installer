msgstr "Ütle, milline fail, näiteks: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Faili pole selles süsteemis; otsin hoidla failide andmebaasist."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Archil põhinevatel süsteemidel pole lisatavaid PPA-sid ega lisahoidlaid. Kogukonna programmid tulevad AUR-ist."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Otsi käsuga “pamac search --aur <name>” ja paigalda käsuga “pamac build <name>”."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Et paketti ei uuendataks, lisa see faili /etc/pacman.conf valikusse IgnorePkg."

msgid "“{command}” has no direct equivalent here."
msgstr "Käsul “{command}” pole siin otsest vastet."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Käivita “{tool} help”, et näha käske, mida see süsteem mõistab."

