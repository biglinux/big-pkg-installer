msgstr "Paket kurulurken bir hata oluştu. Aşağıdaki ayrıntılara bakın."

msgid "The application could not be started"
msgstr "Uygulama başlatılamadı"

msgid "The RPM package is truncated or corrupted."
msgstr "RPM paketi kesilmiş veya bozuk."

msgid "makepkg cannot run as root; run big-pkg-installer as a regular user."
msgstr "makepkg root olarak çalışamaz; big-pkg-installer'u normal bir kullanıcı olarak çalıştırın."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg {code} çıkış koduyla başarısız oldu"

msgid "makepkg finished but produced no package"
msgstr "makepkg bitti ancak hiç paket üretmedi"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "“{typed}” yalnızca paket listesini yeniler. Buradaki güvenli karşılığı hiçbir şey kurmadan güncellemeleri denetler; kurmak için “{upgrade}” komutunu kullanın."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "“pacman -Sy” komutunu asla tek başına çalıştırmayın: yükseltmeden yenilemek sistemi bozabilir."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch tek tek paketleri yükseltmez; tüm sistem birlikte yükseltilir."

msgid "Tell which package to install, for example: {example}"
msgstr "Hangi paketin kurulacağını belirtin, örneğin: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac, AUR ve Flatpak içindeki programları da bulur: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by big-pkg-installer."
msgstr ".deb ve .rpm paketleri big-pkg-installer tarafından yerel pacman paketlerine dönüştürülür."

msgid "Run this command as a regular user (without sudo)."
msgstr "Bu komutu normal kullanıcı olarak çalıştırın (sudo olmadan)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Hangi paketin kaldırılacağını belirtin, örneğin: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n, paketin /etc içine kurduğu yapılandırma dosyalarını da siler."

msgid "There are no orphan packages to remove."
msgstr "Kaldırılacak yetim paket yok."

msgid "Tell what to search for, for example: {example}"
msgstr "Neyin aranacağını belirtin, örneğin: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Hangi paket olduğunu belirtin, örneğin: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "Paket kurulu değil; liste depo dosya veritabanından geliyor."

msgid "Tell which file, for example: {example}"
msgstr "Hangi dosya olduğunu belirtin, örneğin: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Dosya bu sistemde yok; depo dosya veritabanında aranıyor."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Arch tabanlı sistemlerde eklenecek PPA veya ek depo yoktur. Topluluk programları AUR'dan gelir."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "“pamac search --aur <name>” ile arayın ve “pamac build <name>” ile kurun."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Bir paketin yükseltilmesini engellemek için onu /etc/pacman.conf içindeki IgnorePkg satırına ekleyin."

msgid "“{command}” has no direct equivalent here."
msgstr "“{command}” için burada doğrudan bir karşılık yok."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Bu sistemin anladığı komutları görmek için “{tool} help” çalıştırın."

msgid "Tell which .deb file to install, for example: {example}"
msgstr "Hangi .deb dosyasının kurulacağını belirtin, örneğin: {example}"

msgid "This system uses pacman, not {tool}."
msgstr "Bu sistem {tool} değil, pacman kullanır."

