msgid "Extracting package data"
msgstr "Извличане на данните от пакета"

msgid "Adapting the directory layout"
msgstr "Приспособяване на структурата на директориите"

msgid "Resolving dependencies"
msgstr "Откриване на зависимостите"

msgid "Converting maintainer scripts"
msgstr "Преобразуване на скриптовете на поддържащия"

msgid "Building the pacman package"
msgstr "Изграждане на pacman пакета"

msgid "Warning:"
msgstr "Предупреждение:"

msgid "Error:"
msgstr "Грешка:"

msgid "Convert a .deb package into a pacman package and install it."
msgstr "Преобразува .deb пакет в pacman пакет и го инсталира."

msgid "the .deb file"
msgstr ".deb файлът"

msgid "do not ask questions, but open the install script for review"
msgstr "не задавай въпроси, но отвори скрипта за инсталиране за преглед"

msgid "do not ask any question"
msgstr "не задавай никакви въпроси"

msgid "only build the package, do not install it"
msgstr "само изгради пакета, без да го инсталираш"

msgid "keep the built package in DIR"
msgstr "запази изградения пакет в DIR"

msgid "also write a PKGBUILD next to the .deb"
msgstr "запиши и PKGBUILD до .deb файла"

msgid "only write a PKGBUILD, do not build"
msgstr "само запиши PKGBUILD, без изграждане"

msgid "{question} [y/N] "
msgstr "{question} [д/Н] "

msgid "yes"
msgstr "да"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "debtap-mod вече не се нуждае от локална база данни; няма какво да се обнови."

msgid "no .deb file given"
msgstr "не е зададен .deb файл"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "опциите -s и -w са остарели и бяха пренебрегнати"

msgid "Installed size: {size}"
msgstr "Инсталиран размер: {size}"

msgid "PKGBUILD written to {path}"
msgstr "PKGBUILD е записан в {path}"

msgid "cancelled"
msgstr "отказано"

msgid "Package {file} built"
msgstr "Пакетът {file} е изграден"

msgid "Menu entries: {names}"
msgstr "Записи в менюто: {names}"

msgid "Package saved to {path}"
msgstr "Пакетът е запазен в {path}"

msgid "some files belong to other installed packages; remove them first:"
msgstr "някои файлове принадлежат на други инсталирани пакети; първо ги премахнете:"

msgid "Install script that will run as root:"
msgstr "Скрипт за инсталиране, който ще се изпълни като root:"

msgid "Install {name} now?"
msgstr "Да се инсталира ли {name} сега?"

msgid "pacman could not install the package (exit code {code})"
msgstr "pacman не успя да инсталира пакета (код на изход {code})"

msgid "{name} installed successfully"
msgstr "{name} е инсталиран успешно"

msgid "Look for {names} in the applications menu."
msgstr "Потърсете {names} в менюто с приложения."

msgid "This package was built for {deb_arch} but this computer is {host}; it will not run here."
msgstr "Този пакет е изграден за {deb_arch}, а този компютър е {host}; няма да работи тук."

msgid "Extracting {name}…"
msgstr "Извличане на {name}…"

msgid "Ignored unsafe or special entries: {list}"
msgstr "Пренебрегнати са опасни или специални записи: {list}"

msgid "Duplicate file kept from /usr: /{path}"
msgstr "Дублиран файл, запазен от /usr: /{path}"

msgid "Looking for dependencies…"
msgstr "Търсене на зависимости…"

msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "Пренебрегнати са {count} двоични файла, изградени за други системи или архитектури."

msgid "Libraries not found in the repositories: {list}"
msgstr "Библиотеки, които не са намерени в хранилищата: {list}"

msgid "Debian dependencies without an equivalent here: {list}"
msgstr "Зависимости на Debian без еквивалент тук: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "Файлове, които вече принадлежат на други пакети: {list}"

msgid "Building the package…"
msgstr "Изграждане на пакета…"

msgid "The file is not a Debian package (missing ar header)."
msgstr "Файлът не е Debian пакет (липсва ar заглавие)."

msgid "The Debian package is truncated or corrupted."
msgstr "Debian пакетът е съкратен или повреден."

msgid "Unsupported compression in member {name}."
msgstr "Неподдържано свиване в елемента {name}."

msgid "File not found: {path}"
msgstr "Файлът не е намерен: {path}"

msgid "The file is not a Debian package (debian-binary missing)."
msgstr "Файлът не е Debian пакет (липсва debian-binary)."

msgid "The Debian package has no control or data archive."
msgstr "Debian пакетът няма архив control или data."

msgid "The Debian package has no control file."
msgstr "Debian пакетът няма файл control."

msgid "The control file has no Package or Version field."
msgstr "Файлът control няма поле Package или Version."

msgid "Install .deb package"
msgstr "Инсталиране на .deb пакет"

msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "Преобразува Debian пакети в основни pacman пакети и ги инсталира."

msgid "Extracting files"
msgstr "Извличане на файловете"

msgid "Adapting folders to this system"
msgstr "Приспособяване на папките към тази система"

msgid "Finding dependencies"
msgstr "Откриване на зависимостите"

msgid "Preparing installation scripts"
msgstr "Подготовка на скриптовете за инсталиране"

msgid "Building the package"
msgstr "Изграждане на пакета"

msgid "Waiting for authorization"
msgstr "Изчакване на разрешение"

msgid "Installing"
msgstr "Инсталиране"

msgid "About"
msgstr "Относно"

msgid "Main menu"
msgstr "Главно меню"

msgid "Choose a .deb file…"
msgstr "Изберете .deb файл…"

msgid "Install a .deb package"
msgstr "Инсталиране на .deb пакет"

msgid "Open a Debian package or drop it here. It will be converted into a native package for this system and installed."
msgstr "Отворете Debian пакет или го пуснете тук. Той ще бъде преобразуван в основен пакет за тази система и инсталиран."

msgid "Details"
msgstr "Подробности"

msgid "Cancel"
msgstr "Отказ"

msgid "Prefer native packages when available"
msgstr "Предпочитане на основните пакети, когато са налични"

msgid "Programs from the system repositories, Flatpak or AppImage usually work better. Converted .deb packages may not work perfectly."
msgstr "Програмите от системните хранилища, Flatpak или AppImage обикновено работят по-добре. Преобразуваните .deb пакети може да не работят безупречно."

msgid "“{name}” is available in the repositories"
msgstr "„{name}“ е налично в хранилищата"

msgid "Installing the native package is recommended."
msgstr "Препоръчва се инсталирането на основния пакет."

msgid "Open"
msgstr "Отваряне"

msgid "Package"
msgstr "Пакет"

msgid "Version"
msgstr "Версия"

msgid "Architecture"
msgstr "Архитектура"

msgid "Installed size"
msgstr "Инсталиран размер"

msgid "Maintainer"
msgstr "Поддържащ"

msgid "Website"
msgstr "Уебсайт"

msgid "Description"
msgstr "Описание"

msgid "Review before installing"
msgstr "Преглед преди инсталиране"

msgid "Show the dependencies and the scripts that will run as administrator"
msgstr "Показване на зависимостите и скриптовете, които ще се изпълнят като администратор"

msgid "Install"
msgstr "Инсталиране"

msgid "Ready to install"
msgstr "Готово за инсталиране"

msgid "Check what will be installed."
msgstr "Проверете какво ще бъде инсталирано."

msgid "Package name on this system"
msgstr "Име на пакета в тази система"

msgid "Package size"
msgstr "Размер на пакета"

msgid "Applications menu"
msgstr "Меню с приложения"

msgid "No menu entry"
msgstr "Няма запис в менюто"

msgid "Warnings"
msgstr "Предупреждения"

msgid "Notes"
msgstr "Бележки"

msgid "Dependencies"
msgstr "Зависимости"

msgid "Required"
msgstr "Задължителни"

msgid "{n} package"
msgid_plural "{n} packages"
msgstr[0] "{n} пакет"
msgstr[1] "{n} пакета"

msgid "will be downloaded"
msgstr "ще бъдат изтеглени"

msgid "Optional"
msgstr "Допълнителни"

msgid "Scripts"
msgstr "Скриптове"

msgid "These commands from the Debian package run as administrator during installation."
msgstr "Тези команди от Debian пакета се изпълняват като администратор по време на инсталирането."

msgid "Open {name}"
msgstr "Отваряне на {name}"

msgid "Copy details"
msgstr "Копиране на подробностите"

msgid "Close"
msgstr "Затваряне"

msgid "This file cannot be installed"
msgstr "Този файл не може да бъде инсталиран"

msgid "Choose a .deb file"
msgstr "Изберете .deb файл"

msgid "Debian packages"
msgstr "Debian пакети"

msgid "Type your password in the window that will appear."
msgstr "Въведете паролата си в прозореца, който ще се появи."

msgid "Missing dependencies are downloaded from the repositories."
msgstr "Липсващите зависимости се изтеглят от хранилищата."

msgid "Compressing the files, this may take a minute."
msgstr "Файловете се компресират, това може да отнеме минута."

msgid "The package could not be converted"
msgstr "Пакетът не можа да бъде преобразуван"

msgid "Cancelled"
msgstr "Отказано"

msgid "{name} is installed"
msgstr "{name} е инсталиран"

msgid "The package {name} was installed. It has no entry in the applications menu."
msgstr "Пакетът {name} беше инсталиран. Той няма запис в менюто с приложения."

msgid "Installation complete"
msgstr "Инсталирането завърши"

msgid "Authorization was not granted"
msgstr "Разрешението не беше дадено"

msgid "The installation failed"
msgstr "Инсталирането не успя"

msgid "pacman returned an error (code {code}). Open the details to see what happened."
msgstr "pacman върна грешка (код {code}). Отворете подробностите, за да видите какво се е случило."

msgid "The application could not be started"
msgstr "Приложението не можа да бъде стартирано"

msgid "Copied"
msgstr "Копирано"

msgid "Please wait until the installation finishes"
msgstr "Моля, изчакайте инсталирането да приключи"

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg не може да се изпълнява като root; стартирайте debtap-mod като обикновен потребител."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg завърши неуспешно с код на изход {code}"

msgid "makepkg finished but produced no package"
msgstr "makepkg приключи, но не създаде пакет"

msgid "The Debian scripts only register an APT repository and an AppArmor profile for Ubuntu; they are not needed here."
msgstr "Скриптовете на Debian само регистрират хранилище на APT и профил на AppArmor за Ubuntu; тук те не са необходими."

msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "Скриптът {script} настройва хранилище на APT; тази част няма ефект в тази система."
