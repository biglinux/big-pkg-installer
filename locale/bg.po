msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg не може да се изпълнява като root; стартирайте debtap-mod като обикновен потребител."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg завърши неуспешно с код на изход {code}"

msgid "makepkg finished but produced no package"
msgstr "makepkg приключи, но не създаде пакет"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "„{typed}“ само опреснява списъка с пакети. Тук безопасният еквивалент проверява за обновления, без да инсталира нищо; за да ги инсталирате, използвайте „{upgrade}“."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Никога не изпълнявайте „pacman -Sy“ самостоятелно: опресняването без обновяване може да повреди системата."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch не обновява отделни пакети; цялата система се обновява заедно."

msgid "Tell which package to install, for example: {example}"
msgstr "Посочете кой пакет да се инсталира, например: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac намира програми и в AUR и Flatpak: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by debtap-mod."
msgstr "Пакетите .deb и .rpm се преобразуват в родни пакети на pacman от debtap-mod."

msgid "Run this command as a regular user (without sudo)."
msgstr "Изпълнете тази команда като обикновен потребител (без sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Посочете кой пакет да се премахне, например: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n изтрива и конфигурационните файлове, които пакетът е инсталирал в /etc."

msgid "There are no orphan packages to remove."
msgstr "Няма осиротели пакети за премахване."

msgid "Tell what to search for, for example: {example}"
msgstr "Посочете какво да се търси, например: {example}"

