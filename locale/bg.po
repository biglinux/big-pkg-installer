msgstr "apt използва файлове .deb, dnf използва .rpm, pacman използва .pkg.tar.zst."

msgid ".deb and .rpm files are converted and installed with debtap-mod (or a double click)."
msgstr "Файловете .deb и .rpm се преобразуват и инсталират с debtap-mod (или с двоен щрак)."

msgid "Programs from the community"
msgstr "Програми от общността"

msgid "The AUR plays the role of PPAs and COPR."
msgstr "AUR играе ролята на PPA и COPR."

msgid "Use “pamac build <name>”; never run AUR helpers with sudo."
msgstr "Използвайте „pamac build <name>“; никога не изпълнявайте помощници за AUR със sudo."

msgid "Tip: “{tool} help install” shows only the lines about one command."
msgstr "Съвет: „{tool} help install“ показва само редовете за една команда."

msgid "Quick reference: “sudo” is needed to install or remove; searching and listing are not."
msgstr "Бърз справочник: „sudo“ е нужен за инсталиране или премахване; търсенето и изброяването не го изискват."

msgid "Command not found: {cmd}"
msgstr "Командата не е намерена: {cmd}"

msgid "The package's own scripts only register a software repository and an AppArmor profile for other distributions; they are not needed here."
msgstr "Скриптовете на пакета само регистрират хранилище за софтуер и профил на AppArmor за други дистрибуции; тук не са необходими."

msgid "Unsupported RPM payload format."
msgstr "Неподдържан формат на данните (payload) на RPM."

msgid "The file is not an RPM package."
msgstr "Файлът не е пакет RPM."

msgid "This is a source RPM (.src.rpm): it contains source code, not a program to install."
msgstr "Това е изходен RPM (.src.rpm): съдържа изходен код, а не програма за инсталиране."

msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "Скриптът {script} настройва хранилище на APT; тази част няма ефект в тази система."

msgid "The {script} script is written in Lua for RPM itself and was skipped."
msgstr "Скриптът {script} е написан на Lua за самия RPM и беше пропуснат."

msgid "The {script} script configures a DNF/YUM repository; that part has no effect on this system."
msgstr "Скриптът {script} настройва хранилище на DNF/YUM; тази част не оказва влияние върху тази система."
