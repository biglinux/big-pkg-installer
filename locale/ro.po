msgstr "apt update doar reîmprospătează lista; apt upgrade instalează."

msgid "In pacman, -Syu does both together."
msgstr "În pacman, -Syu face ambele deodată."

msgid "Avoid “pacman -Sy” alone: it can break the system."
msgstr "Evitați „pacman -Sy” singur: poate strica sistemul."

msgid "Package types"
msgstr "Tipuri de pachete"

msgid "apt uses .deb files, dnf uses .rpm, pacman uses .pkg.tar.zst."
msgstr "apt folosește fișiere .deb, dnf folosește .rpm, pacman folosește .pkg.tar.zst."

msgid ".deb and .rpm files are converted and installed with big-pkg-installer (or a double click)."
msgstr "Fișierele .deb și .rpm sunt convertite și instalate cu big-pkg-installer (sau printr-un dublu clic)."

