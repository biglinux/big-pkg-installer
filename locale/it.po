msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "“{typed}” aggiorna solo l'elenco dei pacchetti. Qui l'equivalente sicuro controlla gli aggiornamenti senza installare nulla; per installarli usa “{upgrade}”."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Non eseguire mai “pacman -Sy” da solo: aggiornare l'elenco senza aggiornare il sistema può romperlo."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch non aggiorna i singoli pacchetti; l'intero sistema viene aggiornato insieme."

msgid "Tell which package to install, for example: {example}"
msgstr "Indica quale pacchetto installare, ad esempio: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac trova programmi anche in AUR e Flatpak: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by big-pkg-installer."
msgstr "I pacchetti .deb e .rpm vengono convertiti in pacchetti pacman nativi da big-pkg-installer."

msgid "Run this command as a regular user (without sudo)."
msgstr "Esegui questo comando come utente normale (senza sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Indica quale pacchetto rimuovere, ad esempio: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n elimina anche i file di configurazione installati dal pacchetto in /etc."

msgid "There are no orphan packages to remove."
msgstr "Non ci sono pacchetti orfani da rimuovere."

msgid "Tell what to search for, for example: {example}"
msgstr "Indica cosa cercare, ad esempio: {example}"

