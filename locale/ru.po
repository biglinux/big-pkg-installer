msgid "Extracting package data"
msgstr "Распаковка данных пакета"
msgid "Adapting the directory layout"
msgstr "Адаптация структуры каталогов"
msgid "Resolving dependencies"
msgstr "Разрешение зависимостей"
msgid "Converting maintainer scripts"
msgstr "Преобразование скриптов сопровождающего"
msgid "Building the pacman package"
msgstr "Сборка пакета pacman"
msgid "Warning:"
msgstr "Предупреждение:"
msgid "Error:"
msgstr "Ошибка:"
msgid "Convert a .deb package into a pacman package and install it."
msgstr "Преобразует пакет .deb в пакет pacman и устанавливает его."
msgid "the .deb file"
msgstr "файл .deb"
msgid "do not ask questions, but open the install script for review"
msgstr "не задавать вопросов, но открыть скрипт установки для проверки"
msgid "do not ask any question"
msgstr "не задавать никаких вопросов"
msgid "only build the package, do not install it"
msgstr "только собрать пакет, не устанавливать его"
msgid "keep the built package in DIR"
msgstr "сохранить собранный пакет в DIR"
msgid "also write a PKGBUILD next to the .deb"
msgstr "также записать PKGBUILD рядом с файлом .deb"
msgid "only write a PKGBUILD, do not build"
msgstr "только записать PKGBUILD, не собирать"
msgid "{question} [y/N] "
msgstr "{question} [д/Н] "
msgid "yes"
msgstr "да"
msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "debtap-mod больше не нуждается в локальной базе данных; обновлять нечего."
msgid "no .deb file given"
msgstr "файл .deb не указан"
msgid "the -s and -w options are obsolete and were ignored"
msgstr "параметры -s и -w устарели и были проигнорированы"
msgid "Installed size: {size}"
msgstr "Установленный размер: {size}"
msgid "PKGBUILD written to {path}"
msgstr "PKGBUILD записан в {path}"
msgid "cancelled"
msgstr "отменено"
msgid "Package {file} built"
msgstr "Пакет {file} собран"
msgid "Menu entries: {names}"
msgstr "Пункты меню: {names}"
msgid "Package saved to {path}"
msgstr "Пакет сохранён в {path}"
msgid "some files belong to other installed packages; remove them first:"
msgstr "некоторые файлы принадлежат другим установленным пакетам; сначала удалите их:"
msgid "Install script that will run as root:"
msgstr "Скрипт установки, который будет выполнен от имени root:"
msgid "Install {name} now?"
msgstr "Установить {name} сейчас?"
msgid "pacman could not install the package (exit code {code})"
msgstr "pacman не удалось установить пакет (код выхода {code})"
msgid "{name} installed successfully"
msgstr "{name} успешно установлен"
msgid "Look for {names} in the applications menu."
msgstr "Ищите {names} в меню приложений."
msgid "This package was built for {deb_arch} but this computer is {host}; it will not run here."
msgstr "Этот пакет собран для {deb_arch}, а этот компьютер — {host}; здесь он не запустится."
msgid "Extracting {name}…"
msgstr "Распаковка {name}…"
msgid "Ignored unsafe or special entries: {list}"
msgstr "Пропущены небезопасные или особые записи: {list}"
msgid "Duplicate file kept from /usr: /{path}"
msgstr "Дубликат файла оставлен из /usr: /{path}"
msgid "Looking for dependencies…"
msgstr "Поиск зависимостей…"
msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "Пропущено исполняемых файлов, собранных для других систем или архитектур: {count}."
msgid "Libraries not found in the repositories: {list}"
msgstr "Библиотеки, не найденные в репозиториях: {list}"
msgid "Debian dependencies without an equivalent here: {list}"
msgstr "Зависимости Debian без эквивалента здесь: {list}"
msgid "Files already owned by other packages: {list}"
msgstr "Файлы, которыми уже владеют другие пакеты: {list}"
msgid "Building the package…"
msgstr "Сборка пакета…"
msgid "The file is not a Debian package (missing ar header)."
msgstr "Файл не является пакетом Debian (отсутствует заголовок ar)."
msgid "The Debian package is truncated or corrupted."
msgstr "Пакет Debian обрезан или повреждён."
msgid "Unsupported compression in member {name}."
msgstr "Неподдерживаемое сжатие в элементе {name}."
msgid "File not found: {path}"
msgstr "Файл не найден: {path}"
msgid "The file is not a Debian package (debian-binary missing)."
msgstr "Файл не является пакетом Debian (отсутствует debian-binary)."
msgid "The Debian package has no control or data archive."
msgstr "В пакете Debian нет архива control или data."
msgid "The Debian package has no control file."
msgstr "В пакете Debian нет файла control."
msgid "The control file has no Package or Version field."
msgstr "В файле control нет поля Package или Version."
msgid "Install .deb package"
msgstr "Установить пакет .deb"
msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "Преобразует пакеты Debian в нативные пакеты pacman и устанавливает их."
msgid "Extracting files"
msgstr "Распаковка файлов"
msgid "Adapting folders to this system"
msgstr "Адаптация папок к этой системе"
msgid "Finding dependencies"
msgstr "Поиск зависимостей"
msgid "Preparing installation scripts"
msgstr "Подготовка скриптов установки"
msgid "Building the package"
msgstr "Сборка пакета"
msgid "Waiting for authorization"
msgstr "Ожидание авторизации"
msgid "Installing"
msgstr "Установка"
msgid "About"
msgstr "О программе"
msgid "Main menu"
msgstr "Главное меню"
msgid "Choose a .deb file…"
msgstr "Выбрать файл .deb…"
msgid "Install a .deb package"
msgstr "Установить пакет .deb"
msgid "Open a Debian package or drop it here. It will be converted into a native package for this system and installed."
msgstr "Откройте пакет Debian или перетащите его сюда. Он будет преобразован в нативный пакет для этой системы и установлен."
msgid "Details"
msgstr "Подробности"
msgid "Cancel"
msgstr "Отмена"
msgid "Prefer native packages when available"
msgstr "Предпочитать нативные пакеты, если они доступны"
msgid "Programs from the system repositories, Flatpak or AppImage usually work better. Converted .deb packages may not work perfectly."
msgstr "Программы из репозиториев системы, Flatpak или AppImage обычно работают лучше. Преобразованные пакеты .deb могут работать не идеально."
msgid "“{name}” is available in the repositories"
msgstr "«{name}» есть в репозиториях"
msgid "Installing the native package is recommended."
msgstr "Рекомендуется установить нативный пакет."
msgid "Open"
msgstr "Открыть"
msgid "Package"
msgstr "Пакет"
msgid "Version"
msgstr "Версия"
msgid "Architecture"
msgstr "Архитектура"
msgid "Installed size"
msgstr "Установленный размер"
msgid "Maintainer"
msgstr "Сопровождающий"
msgid "Website"
msgstr "Веб-сайт"
msgid "Description"
msgstr "Описание"
msgid "Review before installing"
msgstr "Проверьте перед установкой"
msgid "Show the dependencies and the scripts that will run as administrator"
msgstr "Показать зависимости и скрипты, которые будут выполнены от имени администратора"
msgid "Install"
msgstr "Установить"
msgid "Ready to install"
msgstr "Готово к установке"
msgid "Check what will be installed."
msgstr "Проверьте, что будет установлено."
msgid "Package name on this system"
msgstr "Имя пакета в этой системе"
msgid "Package size"
msgstr "Размер пакета"
msgid "Applications menu"
msgstr "Меню приложений"
msgid "No menu entry"
msgstr "Нет пункта меню"
msgid "Warnings"
msgstr "Предупреждения"
msgid "Notes"
msgstr "Заметки"
msgid "Dependencies"
msgstr "Зависимости"
msgid "Required"
msgstr "Обязательные"
msgid "{n} package"
msgid_plural "{n} packages"
msgstr[0] "{n} пакет"
msgstr[1] "{n} пакета"
msgstr[2] "{n} пакетов"
msgid "will be downloaded"
msgstr "будет загружено"
msgid "Optional"
msgstr "Необязательные"
msgid "Scripts"
msgstr "Скрипты"
msgid "These commands from the Debian package run as administrator during installation."
msgstr "Эти команды из пакета Debian выполняются от имени администратора во время установки."
msgid "Open {name}"
msgstr "Открыть {name}"
msgid "Copy details"
msgstr "Копировать подробности"
msgid "Close"
msgstr "Закрыть"
msgid "This file cannot be installed"
msgstr "Этот файл невозможно установить"
msgid "Choose a .deb file"
msgstr "Выберите файл .deb"
msgid "Debian packages"
msgstr "Пакеты Debian"
msgid "Type your password in the window that will appear."
msgstr "Введите пароль в появившемся окне."
msgid "Missing dependencies are downloaded from the repositories."
msgstr "Недостающие зависимости загружаются из репозиториев."
msgid "Compressing the files, this may take a minute."
msgstr "Сжатие файлов, это может занять минуту."
msgid "The package could not be converted"
msgstr "Не удалось преобразовать пакет"
msgid "Cancelled"
msgstr "Отменено"
msgid "{name} is installed"
msgstr "{name} установлен"
msgid "The package {name} was installed. It has no entry in the applications menu."
msgstr "Пакет {name} установлен. В меню приложений для него нет пункта."
msgid "Installation complete"
msgstr "Установка завершена"
msgid "Authorization was not granted"
msgstr "Авторизация не была предоставлена"
msgid "The installation failed"
msgstr "Установка не удалась"
msgid "pacman returned an error (code {code}). Open the details to see what happened."
msgstr "pacman вернул ошибку (код {code}). Откройте подробности, чтобы узнать, что произошло."
msgid "The application could not be started"
msgstr "Не удалось запустить приложение"
msgid "Copied"
msgstr "Скопировано"
msgid "Please wait until the installation finishes"
msgstr "Подождите, пока установка завершится"
msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg нельзя запускать от имени root; запустите debtap-mod от обычного пользователя."
msgid "makepkg failed with exit code {code}"
msgstr "makepkg завершился с ошибкой, код выхода {code}"
msgid "makepkg finished but produced no package"
msgstr "makepkg завершился, но не создал пакет"
msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "«{typed}» только обновляет список пакетов. Здесь безопасный аналог проверяет наличие обновлений, ничего не устанавливая; чтобы установить их, используйте «{upgrade}»."
msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Никогда не запускайте «pacman -Sy» отдельно: обновление списка без обновления пакетов может сломать систему."
msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch не обновляет отдельные пакеты; вся система обновляется целиком."
msgid "Tell which package to install, for example: {example}"
msgstr "Укажите, какой пакет установить, например: {example}"
msgid ".rpm packages are made for Fedora/openSUSE and cannot be installed here."
msgstr "Пакеты .rpm созданы для Fedora/openSUSE и не могут быть установлены здесь."
msgid "Look for the program in the repositories (pamac search), on Flathub, or as an AppImage."
msgstr "Поищите программу в репозиториях (pamac search), на Flathub или в виде AppImage."
msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac также находит программы в AUR и Flatpak: {cmd}"
msgid ".deb packages are converted into native pacman packages by debtap-mod."
msgstr "Пакеты .deb преобразуются в нативные пакеты pacman с помощью debtap-mod."
msgid "Run this command as a regular user (without sudo)."
msgstr "Запустите эту команду от обычного пользователя (без sudo)."
msgid "Tell which package to remove, for example: {example}"
msgstr "Укажите, какой пакет удалить, например: {example}"
msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n также удаляет файлы конфигурации, установленные пакетом в /etc."
msgid "There are no orphan packages to remove."
msgstr "Нет пакетов-сирот для удаления."
msgid "Tell what to search for, for example: {example}"
msgstr "Укажите, что искать, например: {example}"
msgid "Tell which package, for example: {example}"
msgstr "Укажите пакет, например: {example}"
msgid "The package is not installed; the list comes from the repository file database."
msgstr "Пакет не установлен; список взят из базы данных файлов репозитория."
msgid "Tell which file, for example: {example}"
msgstr "Укажите файл, например: {example}"
msgid "The file is not on this system; searching the repository file database."
msgstr "Файла нет в этой системе; идёт поиск в базе данных файлов репозитория."
msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "В системах на основе Arch нет PPA и дополнительных репозиториев для добавления. Программы от сообщества берутся из AUR."
msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Ищите командой «pamac search --aur <name>», а устанавливайте командой «pamac build <name>»."
msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Чтобы пакет не обновлялся, добавьте его в IgnorePkg в /etc/pacman.conf."
msgid "“{command}” has no direct equivalent here."
msgstr "У «{command}» здесь нет прямого аналога."
msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Запустите «{tool} help», чтобы увидеть команды, которые понимает эта система."
msgid "Tell which .deb file to install, for example: {example}"
msgstr "Укажите, какой файл .deb установить, например: {example}"
msgid "This system uses pacman, not {tool}."
msgstr "Эта система использует pacman, а не {tool}."
msgid "You typed:"
msgstr "Вы ввели:"
msgid "Equivalent:"
msgstr "Аналог:"
msgid "With pamac:"
msgstr "С помощью pamac:"
msgid "Running:"
msgstr "Выполняется:"
msgid "Update everything"
msgstr "Обновить всё"
msgid "Check for updates"
msgstr "Проверить обновления"
msgid "Install a program"
msgstr "Установить программу"
msgid "Install a downloaded file"
msgstr "Установить загруженный файл"
msgid "Install a .deb file here"
msgstr "Установить файл .deb отсюда"
msgid "Reinstall"
msgstr "Переустановить"
msgid "Remove a program"
msgstr "Удалить программу"
msgid "Remove + dependencies"
msgstr "Удалить + зависимости"
msgid "Remove + configuration"
msgstr "Удалить + конфигурацию"
msgid "Remove orphans (unused)"
msgstr "Удалить сирот (неиспользуемые)"
msgid "Search to install"
msgstr "Поиск для установки"
msgid "Details (available)"
msgstr "Сведения (доступные)"
msgid "Details (installed)"
msgstr "Сведения (установленные)"
msgid "List everything available"
msgstr "Список всего доступного"
msgid "List installed"
msgstr "Список установленных"
msgid "Search installed"
msgstr "Поиск среди установленных"
msgid "Files of a package"
msgstr "Файлы пакета"
msgid "Which package owns a file?"
msgstr "Какому пакету принадлежит файл?"
msgid "What can be upgraded"
msgstr "Что можно обновить"
msgid "Installed by you"
msgstr "Установлено вами"
msgid "Dependencies of a package"
msgstr "Зависимости пакета"
msgid "Who depends on a package"
msgstr "Что зависит от пакета"
msgid "Clean the download cache"
msgstr "Очистить кэш загрузок"
msgid "Add a repository / PPA"
msgstr "Добавить репозиторий / PPA"
msgid "(AUR)"
msgstr "(AUR)"
msgid "Command translator: {family} (Debian, Ubuntu, Mint, Fedora) to pacman and pamac (Arch, BigLinux, Manjaro)"
msgstr "Переводчик команд: {family} (Debian, Ubuntu, Mint, Fedora) в pacman и pamac (Arch, BigLinux, Manjaro)"
msgid "Both do the same job: install, update and remove programs. Only the commands change."
msgstr "Оба делают одно и то же: устанавливают, обновляют и удаляют программы. Меняются только команды."
msgid "You can keep typing {tool} commands: they are translated and run with pamac or pacman."
msgstr "Вы можете и дальше вводить команды {tool}: они переводятся и выполняются с помощью pamac или pacman."
msgid "No command matches “{topic}”."
msgstr "Ни одна команда не соответствует «{topic}»."
msgid "Run “{tool} help” to see every command."
msgstr "Запустите «{tool} help», чтобы увидеть все команды."
msgid "What you want to do"
msgstr "Что вы хотите сделать"
msgid "Differences that catch people"
msgstr "Различия, о которые спотыкаются"
msgid "apt update only refreshes the list; apt upgrade installs."
msgstr "apt update только обновляет список; apt upgrade устанавливает."
msgid "In pacman, -Syu does both together."
msgstr "В pacman -Syu делает и то и другое сразу."
msgid "Avoid “pacman -Sy” alone: it can break the system."
msgstr "Избегайте «pacman -Sy» отдельно: это может сломать систему."
msgid "Package types"
msgstr "Типы пакетов"
msgid "apt uses .deb files, dnf uses .rpm, pacman uses .pkg.tar.zst."
msgstr "apt использует файлы .deb, dnf — .rpm, pacman — .pkg.tar.zst."
msgid ".deb files are converted and installed with debtap-mod (or a double click)."
msgstr "Файлы .deb преобразуются и устанавливаются с помощью debtap-mod (или двойным щелчком)."
msgid "Programs from the community"
msgstr "Программы от сообщества"
msgid "The AUR plays the role of PPAs and COPR."
msgstr "AUR играет роль PPA и COPR."
msgid "Use “pamac build <name>”; never run AUR helpers with sudo."
msgstr "Используйте «pamac build <name>»; никогда не запускайте помощники AUR с sudo."
msgid "Tip: “{tool} help install” shows only the lines about one command."
msgstr "Совет: «{tool} help install» показывает только строки об одной команде."
msgid "Quick reference: “sudo” is needed to install or remove; searching and listing are not."
msgstr "Краткая справка: «sudo» нужен для установки и удаления; поиск и просмотр списков его не требуют."
msgid "Command not found: {cmd}"
msgstr "Команда не найдена: {cmd}"
msgid "The Debian scripts only register an APT repository and an AppArmor profile for Ubuntu; they are not needed here."
msgstr "Скрипты Debian лишь регистрируют репозиторий APT и профиль AppArmor для Ubuntu; здесь они не нужны."
msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "Скрипт {script} настраивает репозиторий APT; эта часть не влияет на эту систему."
