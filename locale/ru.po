msgstr "Этот пакет собран для архитектуры {deb_arch}, а ваша система — {host}."

msgid "Package"
msgstr "Пакет"

msgid "Package architecture"
msgstr "Архитектура пакета"

msgid "System architecture"
msgstr "Архитектура системы"

msgid "This package cannot be installed on this computer. Look for a version of the package made for {host}."
msgstr "Этот пакет нельзя установить на этот компьютер. Поищите версию пакета, собранную для {host}."

msgid "This file cannot be installed"
msgstr "Этот файл невозможно установить"

msgid "The file may be damaged or is not a valid package. Download it again or check where it came from."
msgstr "Файл может быть повреждён или не является допустимым пакетом. Скачайте его заново или проверьте, откуда он взят."

msgid "Invalid file"
msgstr "Недопустимый файл"

msgid "The selected file is not a .deb or .rpm package."
msgstr "Выбранный файл не является пакетом .deb или .rpm."

msgid "This installer works only with .deb and .rpm files (packages for Debian, Ubuntu, Fedora, openSUSE and their derivatives)."
msgstr "Этот установщик работает только с файлами .deb и .rpm (пакеты для Debian, Ubuntu, Fedora, openSUSE и их производных)."

msgid "Choose a package file"
msgstr "Выберите файл пакета"

msgid "Packages (.deb, .rpm)"
msgstr "Пакеты (.deb, .rpm)"

