msgstr ".deb 또는 .rpm 패키지를 pacman 패키지로 변환하여 설치합니다."

msgid "the .deb or .rpm file"
msgstr ".deb 또는 .rpm 파일"

msgid "do not ask questions, but open the install script for review"
msgstr "질문하지 않고 검토할 수 있도록 설치 스크립트를 엽니다"

msgid "do not ask any question"
msgstr "질문하지 않음"

msgid "only build the package, do not install it"
msgstr "패키지를 빌드만 하고 설치하지 않음"

msgid "keep the built package in DIR"
msgstr "빌드한 패키지를 DIR에 보관"

msgid "also write a PKGBUILD next to the package file"
msgstr "패키지 파일 옆에 PKGBUILD도 작성"

msgid "only write a PKGBUILD, do not build"
msgstr "PKGBUILD만 저장하고 빌드하지 않음"

msgid "{question} [y/N] "
msgstr "{question} [y/N] "

msgid "yes"
msgstr "y"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "debtap-mod는 더 이상 로컬 데이터베이스가 필요하지 않습니다. 업데이트할 것이 없습니다."

msgid "no package file given"
msgstr "패키지 파일이 지정되지 않았습니다"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "-s 및 -w 옵션은 더 이상 사용되지 않으며 무시되었습니다"

msgid "Installed size: {size}"
msgstr "설치 크기: {size}"

