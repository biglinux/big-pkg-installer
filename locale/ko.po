msgstr "안전하지 않거나 특수한 항목을 무시했습니다: {list}"

msgid "Duplicate file kept from /usr: /{path}"
msgstr "/usr의 중복 파일을 유지했습니다: /{path}"

msgid "Looking for dependencies…"
msgstr "의존성을 찾는 중…"

msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "다른 시스템 또는 아키텍처용으로 빌드된 바이너리 {count}개를 무시했습니다."

msgid "Libraries not found in the repositories: {list}"
msgstr "저장소에서 찾을 수 없는 라이브러리: {list}"

msgid "Package dependencies without an equivalent here: {list}"
msgstr "여기에 대응하는 항목이 없는 패키지 의존성: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "이미 다른 패키지가 소유한 파일: {list}"

msgid "Building the package…"
msgstr "패키지 빌드 중…"

