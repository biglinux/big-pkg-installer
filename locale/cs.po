msgstr "pouze zapsat PKGBUILD, nesestavovat"

msgid "{question} [y/N] "
msgstr "{question} [a/N] "

msgid "yes"
msgstr "ano"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "debtap-mod už nepotřebuje místní databázi; není co aktualizovat."

msgid "no .deb file given"
msgstr "není zadán žádný soubor .deb"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "přepínače -s a -w jsou zastaralé a byly ignorovány"

