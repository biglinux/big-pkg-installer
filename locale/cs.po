msgstr "Balíček RPM je useknutý nebo poškozený."

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg nelze spustit jako root; spusťte debtap-mod jako běžný uživatel."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg selhal s návratovým kódem {code}"

msgid "makepkg finished but produced no package"
msgstr "makepkg skončil, ale nevytvořil žádný balíček"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "„{typed}“ pouze obnoví seznam balíčků. Zde bezpečný ekvivalent zkontroluje aktualizace, aniž by cokoli instaloval; k jejich instalaci použijte „{upgrade}“."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Nikdy nespouštějte samotné „pacman -Sy“: obnovení bez aktualizace může systém poškodit."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch neaktualizuje jednotlivé balíčky; celý systém se aktualizuje najednou."

msgid "Tell which package to install, for example: {example}"
msgstr "Řekněte, který balíček nainstalovat, například: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac najde programy také v AUR a Flatpaku: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by debtap-mod."
msgstr "Balíčky .deb a .rpm jsou pomocí debtap-mod převedeny na nativní balíčky pacman."

msgid "Run this command as a regular user (without sudo)."
msgstr "Spusťte tento příkaz jako běžný uživatel (bez sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Řekněte, který balíček odebrat, například: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n smaže také konfigurační soubory, které balíček nainstaloval do /etc."

msgid "There are no orphan packages to remove."
msgstr "Nejsou žádné osiřelé balíčky k odebrání."

msgid "Tell what to search for, for example: {example}"
msgstr "Řekněte, co hledat, například: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Řekněte, který balíček, například: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "Balíček není nainstalován; seznam pochází z databáze souborů repozitáře."

msgid "Tell which file, for example: {example}"
msgstr "Řekněte, který soubor, například: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Soubor není v tomto systému; hledá se v databázi souborů repozitáře."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Systémy založené na Archu nemají PPA ani další repozitáře k přidání. Programy od komunity pocházejí z AUR."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Hledejte pomocí „pamac search --aur <name>“ a instalujte pomocí „pamac build <name>“."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Aby se balíček neaktualizoval, přidejte jej do IgnorePkg v /etc/pacman.conf."

msgid "“{command}” has no direct equivalent here."
msgstr "„{command}“ zde nemá přímý ekvivalent."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Spusťte „{tool} help“ a zobrazí se příkazy, kterým tento systém rozumí."

