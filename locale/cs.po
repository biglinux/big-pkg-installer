msgid "Command translator: {family} (Debian, Ubuntu, Mint, Fedora) to pacman and pamac (Arch, BigLinux, Manjaro)"
msgstr "Překladač příkazů: {family} (Debian, Ubuntu, Mint, Fedora) na pacman a pamac (Arch, BigLinux, Manjaro)"

msgid "Both do the same job: install, update and remove programs. Only the commands change."
msgstr "Oba dělají stejnou práci: instalují, aktualizují a odebírají programy. Mění se jen příkazy."

msgid "You can keep typing {tool} commands: they are translated and run with pamac or pacman."
msgstr "Příkazy {tool} můžete psát dál: přeloží se a spustí pomocí pamac nebo pacman."

msgid "No command matches “{topic}”."
msgstr "Žádný příkaz neodpovídá „{topic}“."

msgid "Run “{tool} help” to see every command."
msgstr "Spusťte „{tool} help“ a zobrazí se všechny příkazy."

msgid "What you want to do"
msgstr "Co chcete udělat"

msgid "Differences that catch people"
msgstr "Rozdíly, které lidi překvapí"

msgid "apt update only refreshes the list; apt upgrade installs."
msgstr "apt update pouze obnoví seznam; apt upgrade instaluje."

msgid "In pacman, -Syu does both together."
msgstr "V pacmanu dělá -Syu obojí najednou."

msgid "Avoid “pacman -Sy” alone: it can break the system."
msgstr "Vyhněte se samotnému „pacman -Sy“: může poškodit systém."

msgid "Package types"
msgstr "Typy balíčků"

msgid "apt uses .deb files, dnf uses .rpm, pacman uses .pkg.tar.zst."
msgstr "apt používá soubory .deb, dnf používá .rpm, pacman používá .pkg.tar.zst."

msgid ".deb and .rpm files are converted and installed with debtap-mod (or a double click)."
msgstr "Soubory .deb a .rpm se pomocí debtap-mod převedou a nainstalují (nebo dvojitým kliknutím)."

msgid "Programs from the community"
msgstr "Programy od komunity"

msgid "The AUR plays the role of PPAs and COPR."
msgstr "AUR hraje roli PPA a COPR."

msgid "Use “pamac build <name>”; never run AUR helpers with sudo."
msgstr "Použijte „pamac build <name>“; pomocníky pro AUR nikdy nespouštějte přes sudo."

msgid "Tip: “{tool} help install” shows only the lines about one command."
msgstr "Tip: „{tool} help install“ zobrazí jen řádky o jednom příkazu."

msgid "Quick reference: “sudo” is needed to install or remove; searching and listing are not."
msgstr "Stručný přehled: „sudo“ je potřeba k instalaci nebo odebrání; hledání a vypisování ne."

msgid "Command not found: {cmd}"
msgstr "Příkaz nenalezen: {cmd}"

msgid "The package's own scripts only register a software repository and an AppArmor profile for other distributions; they are not needed here."
msgstr "Vlastní skripty balíčku pouze registrují softwarový repozitář a profil AppArmor pro jiné distribuce; zde nejsou potřeba."

msgid "Unsupported RPM payload format."
msgstr "Nepodporovaný formát obsahu RPM."

msgid "The file is not an RPM package."
msgstr "Soubor není balíček RPM."

msgid "This is a source RPM (.src.rpm): it contains source code, not a program to install."
msgstr "Toto je zdrojový RPM (.src.rpm): obsahuje zdrojový kód, nikoli program k instalaci."

msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "Skript {script} nastavuje repozitář APT; tato část na tomto systému nemá žádný účinek."

msgid "The {script} script is written in Lua for RPM itself and was skipped."
msgstr "Skript {script} je napsán v jazyce Lua pro samotný RPM a byl přeskočen."

msgid "The {script} script configures a DNF/YUM repository; that part has no effect on this system."
msgstr "Skript {script} nastavuje repozitář DNF/YUM; tato část na tento systém nemá žádný vliv."
