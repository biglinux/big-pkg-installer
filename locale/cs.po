msgstr "{name} byl úspěšně nainstalován"

msgid "Look for {names} in the applications menu."
msgstr "Hledejte {names} v nabídce aplikací."

msgid "This package was built for {deb_arch} but this computer is {host}; it will not run here."
msgstr "Tento balíček byl sestaven pro {deb_arch}, ale tento počítač je {host}; zde nepoběží."

msgid "Extracting {name}…"
msgstr "Rozbalování {name}…"

msgid "Ignored unsafe or special entries: {list}"
msgstr "Ignorované nebezpečné nebo speciální položky: {list}"

msgid "Duplicate file kept from /usr: /{path}"
msgstr "Duplicitní soubor ponechán z /usr: /{path}"

msgid "Looking for dependencies…"
msgstr "Hledání závislostí…"

msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "Ignorováno {count} binárních souborů sestavených pro jiné systémy nebo architektury."

msgid "Libraries not found in the repositories: {list}"
msgstr "Knihovny nenalezené v repozitářích: {list}"

msgid "Debian dependencies without an equivalent here: {list}"
msgstr "Závislosti Debianu bez ekvivalentu zde: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "Soubory, které už patří jiným balíčkům: {list}"

msgid "Building the package…"
msgstr "Sestavování balíčku…"

msgid "The file is not a Debian package (missing ar header)."
msgstr "Soubor není balíček Debianu (chybí hlavička ar)."

msgid "The Debian package is truncated or corrupted."
msgstr "Balíček Debianu je zkrácený nebo poškozený."

msgid "Unsupported compression in member {name}."
msgstr "Nepodporovaná komprese v části {name}."

msgid "File not found: {path}"
msgstr "Soubor nenalezen: {path}"

msgid "The file is not a Debian package (debian-binary missing)."
msgstr "Soubor není balíček Debianu (chybí debian-binary)."

msgid "The Debian package has no control or data archive."
msgstr "Balíček Debianu neobsahuje archiv control ani data."

msgid "The Debian package has no control file."
msgstr "Balíček Debianu neobsahuje soubor control."

msgid "The control file has no Package or Version field."
msgstr "Soubor control neobsahuje pole Package ani Version."

msgid "Install .deb package"
msgstr "Instalace balíčku .deb"

msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "Převádí balíčky Debianu na nativní balíčky pacman a instaluje je."

msgid "Extracting files"
msgstr "Rozbalování souborů"

msgid "Adapting folders to this system"
msgstr "Přizpůsobení složek tomuto systému"

msgid "Finding dependencies"
msgstr "Hledání závislostí"

msgid "Preparing installation scripts"
msgstr "Příprava instalačních skriptů"

