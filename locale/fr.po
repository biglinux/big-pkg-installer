msgstr "apt update ne fait qu’actualiser la liste ; apt upgrade installe."

msgid "In pacman, -Syu does both together."
msgstr "Avec pacman, -Syu fait les deux à la fois."

msgid "Avoid “pacman -Sy” alone: it can break the system."
msgstr "Évitez « pacman -Sy » seul : cela peut casser le système."

msgid "Package types"
