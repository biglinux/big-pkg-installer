msgstr "Залежності пакета, які не мають відповідника тут: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "Файли, які вже належать іншим пакункам: {list}"

msgid "Building the package…"
msgstr "Збирання пакунка…"

msgid "The file is not a Debian package (missing ar header)."
msgstr "Файл не є пакунком Debian (бракує заголовка ar)."

msgid "The Debian package is truncated or corrupted."
msgstr "Пакунок Debian обрізано або пошкоджено."

msgid "Unsupported compression in member {name}."
msgstr "Непідтримуване стиснення в елементі {name}."

msgid "File not found: {path}"
msgstr "Файл не знайдено: {path}"

msgid "The file is not a Debian package (debian-binary missing)."
msgstr "Файл не є пакунком Debian (бракує debian-binary)."

msgid "The Debian package has no control or data archive."
msgstr "У пакунку Debian немає архіву control або data."

msgid "The Debian package has no control file."
msgstr "У пакунку Debian немає файлу control."

msgid "The control file has no Package or Version field."
msgstr "У файлі control немає поля Package або Version."

