msgstr "Цей пакунок зібрано для архітектури {deb_arch}, але ваша система має архітектуру {host}."

msgid "Package"
msgstr "Пакунок"

msgid "Package architecture"
msgstr "Архітектура пакунка"

msgid "System architecture"
msgstr "Архітектура системи"

msgid "This package cannot be installed on this computer. Look for a version of the package made for {host}."
msgstr "Цей пакунок не можна встановити на цьому комп’ютері. Знайдіть версію пакунка, створену для {host}."

msgid "This file cannot be installed"
msgstr "Цей файл неможливо встановити"

msgid "The file may be damaged or is not a valid package. Download it again or check where it came from."
msgstr "Файл може бути пошкоджений або не є дійсним пакетом. Завантажте його ще раз або перевірте, звідки він узявся."

msgid "Invalid file"
msgstr "Недійсний файл"

msgid "The selected file is not a .deb or .rpm package."
msgstr "Вибраний файл не є пакетом .deb або .rpm."

msgid "This installer works only with .deb and .rpm files (packages for Debian, Ubuntu, Fedora, openSUSE and their derivatives)."
msgstr "Цей інсталятор працює лише з файлами .deb і .rpm (пакети для Debian, Ubuntu, Fedora, openSUSE та їхніх похідних)."

