msgstr "Перетворює пакет .deb або .rpm на пакет pacman і встановлює його."

msgid "the .deb or .rpm file"
msgstr "файл .deb або .rpm"

msgid "do not ask questions, but open the install script for review"
msgstr "не ставити запитань, але відкрити скрипт встановлення для перегляду"

