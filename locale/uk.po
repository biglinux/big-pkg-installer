msgstr "Деякі пакунки, потрібні цій програмі, не знайдено в репозиторіях."

msgid "Installing the package"
msgstr "Встановлення пакунка"

msgid "Preparing the installation…"
msgstr "Підготовка до встановлення…"

msgid "Downloading and installing dependencies…"
msgstr "Завантаження й встановлення залежностей…"

msgid "Installing packages…"
msgstr "Встановлення пакунків…"

msgid "Configuring the system…"
msgstr "Налаштування системи…"

msgid "Finishing…"
msgstr "Завершення…"

msgid "Please wait until the installation finishes"
msgstr "Зачекайте, доки завершиться встановлення"

msgid "Authorization was not granted"
msgstr "Авторизацію не надано"

msgid "The installation failed"
msgstr "Не вдалося встановити"

msgid "An error happened while installing the package. See the details below."
msgstr "Під час встановлення пакунка сталася помилка. Подробиці наведено нижче."

msgid "The application could not be started"
msgstr "Не вдалося запустити застосунок"

msgid "The RPM package is truncated or corrupted."
msgstr "Пакет RPM обрізаний або пошкоджений."

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg не може працювати від імені root; запускайте debtap-mod як звичайний користувач."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg завершився помилкою з кодом {code}"

msgid "makepkg finished but produced no package"
msgstr "makepkg завершився, але не створив жодного пакунка"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "«{typed}» лише оновлює список пакунків. Тут безпечний еквівалент перевіряє наявність оновлень, нічого не встановлюючи; щоб їх встановити, скористайтеся «{upgrade}»."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Ніколи не запускайте «pacman -Sy» окремо: оновлення списку без оновлення системи може її зламати."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch не оновлює окремі пакунки; уся система оновлюється разом."

msgid "Tell which package to install, for example: {example}"
msgstr "Вкажіть, який пакунок встановити, наприклад: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac також знаходить програми в AUR і Flatpak: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by debtap-mod."
msgstr "Пакети .deb і .rpm перетворюються на рідні пакети pacman за допомогою debtap-mod."

msgid "Run this command as a regular user (without sudo)."
msgstr "Виконайте цю команду як звичайний користувач (без sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Вкажіть, який пакунок видалити, наприклад: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n також видаляє файли конфігурації, які пакунок встановив у /etc."

msgid "There are no orphan packages to remove."
msgstr "Немає осиротілих пакунків для видалення."

msgid "Tell what to search for, for example: {example}"
msgstr "Вкажіть, що шукати, наприклад: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Вкажіть, який пакунок, наприклад: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "Пакунок не встановлено; список взято з бази даних файлів репозиторію."

msgid "Tell which file, for example: {example}"
msgstr "Вкажіть, який файл, наприклад: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Файлу немає в цій системі; пошук у базі даних файлів репозиторію."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "У системах на основі Arch немає PPA чи додаткових репозиторіїв для додавання. Програми від спільноти беруться з AUR."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Шукайте за допомогою «pamac search --aur <name>» і встановлюйте за допомогою «pamac build <name>»."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Щоб пакунок не оновлювався, додайте його до IgnorePkg у /etc/pacman.conf."

msgid "“{command}” has no direct equivalent here."
msgstr "Для «{command}» тут немає прямого еквівалента."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Виконайте «{tool} help», щоб побачити команди, які розуміє ця система."

msgid "Tell which .deb file to install, for example: {example}"
msgstr "Вкажіть, який файл .deb встановити, наприклад: {example}"

msgid "This system uses pacman, not {tool}."
msgstr "Ця система використовує pacman, а не {tool}."

