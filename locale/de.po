msgstr "Entfernen + Abhängigkeiten"

msgid "Remove + configuration"
msgstr "Entfernen + Konfiguration"

msgid "Remove orphans (unused)"
msgstr "Verwaiste entfernen (unbenutzt)"

msgid "Search to install"
msgstr "Suchen zum Installieren"

msgid "Details (available)"
msgstr "Details (verfügbar)"

