msgstr "Konverter en .deb-pakke til en pacman-pakke og installer den."

msgid "the .deb file"
msgstr ".deb-filen"

msgid "do not ask questions, but open the install script for review"
msgstr "ikke still spørsmål, men åpne installasjonsskriptet for gjennomgang"

