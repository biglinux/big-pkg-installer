msgstr "Hovedmeny"

msgid "Choose a .deb file…"
msgstr "Velg en .deb-fil …"

msgid "Install a .deb package"
msgstr "Installer en .deb-pakke"

msgid "Open a Debian package or drop it here. It will be converted into a native package for this system and installed."
msgstr "Åpne en Debian-pakke eller slipp den her. Den blir konvertert til en egen pakke for dette systemet og installert."

msgid "Details"
msgstr "Detaljer"

msgid "Cancel"
msgstr "Avbryt"

msgid "Prefer native packages when available"
msgstr "Foretrekk egne pakker når de finnes"

msgid "Programs from the system repositories, Flatpak or AppImage usually work better. Converted .deb packages may not work perfectly."
msgstr "Programmer fra systemets pakkebrønner, Flatpak eller AppImage fungerer vanligvis bedre. Konverterte .deb-pakker fungerer kanskje ikke perfekt."

msgid "“{name}” is available in the repositories"
msgstr "«{name}» er tilgjengelig i pakkebrønnene"

msgid "Installing the native package is recommended."
msgstr "Det anbefales å installere den egne pakken."

msgid "Open"
msgstr "Åpne"

msgid "Package"
msgstr "Pakke"

msgid "Version"
msgstr "Versjon"

