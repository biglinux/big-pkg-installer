msgstr "Skript"

msgid "These commands from the Debian package run as administrator during installation."
msgstr "Disse kommandoene fra Debian-pakken kjøres som administrator under installeringen."

msgid "Open {name}"
msgstr "Åpne {name}"

msgid "Copy details"
msgstr "Kopier detaljer"

msgid "Close"
msgstr "Lukk"

msgid "This file cannot be installed"
msgstr "Denne filen kan ikke installeres"

msgid "Choose a .deb file"
msgstr "Velg en .deb-fil"

msgid "Debian packages"
msgstr "Debian-pakker"

msgid "Type your password in the window that will appear."
msgstr "Skriv inn passordet ditt i vinduet som dukker opp."

msgid "Missing dependencies are downloaded from the repositories."
msgstr "Manglende avhengigheter lastes ned fra pakkebrønnene."

msgid "Compressing the files, this may take a minute."
msgstr "Komprimerer filene. Dette kan ta et minutt."

msgid "The package could not be converted"
msgstr "Pakken kunne ikke konverteres"

msgid "Cancelled"
msgstr "Avbrutt"

msgid "{name} is installed"
msgstr "{name} er installert"

msgid "The package {name} was installed. It has no entry in the applications menu."
msgstr "Pakken {name} ble installert. Den har ingen oppføring i programmenyen."

msgid "Installation complete"
msgstr "Installeringen er fullført"

msgid "Authorization was not granted"
msgstr "Godkjenning ble ikke gitt"

msgid "The installation failed"
msgstr "Installeringen mislyktes"

msgid "pacman returned an error (code {code}). Open the details to see what happened."
msgstr "pacman returnerte en feil (kode {code}). Åpne detaljene for å se hva som skjedde."

msgid "The application could not be started"
msgstr "Programmet kunne ikke startes"

msgid "Copied"
msgstr "Kopiert"

msgid "Please wait until the installation finishes"
msgstr "Vent til installeringen er ferdig"

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg kan ikke kjøres som root; kjør debtap-mod som vanlig bruker."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg mislyktes med avslutningskode {code}"

msgid "makepkg finished but produced no package"
msgstr "makepkg ble ferdig, men lagde ingen pakke"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "«{typed}» oppdaterer bare pakkelisten. Her sjekker den trygge ekvivalenten etter oppdateringer uten å installere noe; for å installere dem, bruk «{upgrade}»."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Kjør aldri «pacman -Sy» alene: å oppdatere listen uten å oppgradere kan ødelegge systemet."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch oppgraderer ikke enkeltpakker; hele systemet oppgraderes samlet."

msgid "Tell which package to install, for example: {example}"
msgstr "Oppgi hvilken pakke som skal installeres, for eksempel: {example}"

msgid ".rpm packages are made for Fedora/openSUSE and cannot be installed here."
msgstr ".rpm-pakker er laget for Fedora/openSUSE og kan ikke installeres her."

msgid "Look for the program in the repositories (pamac search), on Flathub, or as an AppImage."
msgstr "Se etter programmet i pakkebrønnene (pamac search), på Flathub eller som AppImage."

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac finner også programmer i AUR og Flatpak: {cmd}"

msgid ".deb packages are converted into native pacman packages by debtap-mod."
msgstr ".deb-pakker konverteres til egne pacman-pakker av debtap-mod."

msgid "Run this command as a regular user (without sudo)."
msgstr "Kjør denne kommandoen som vanlig bruker (uten sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Oppgi hvilken pakke som skal fjernes, for eksempel: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n sletter også konfigurasjonsfilene pakken installerte i /etc."

msgid "There are no orphan packages to remove."
msgstr "Det finnes ingen foreldreløse pakker å fjerne."

msgid "Tell what to search for, for example: {example}"
msgstr "Oppgi hva du vil søke etter, for eksempel: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Oppgi hvilken pakke, for eksempel: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "Pakken er ikke installert; listen kommer fra fildatabasen til pakkebrønnen."

msgid "Tell which file, for example: {example}"
msgstr "Oppgi hvilken fil, for eksempel: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Filen finnes ikke på dette systemet; søker i fildatabasen til pakkebrønnen."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Arch-baserte systemer har ingen PPA-er eller ekstra pakkebrønner å legge til. Programmer fra fellesskapet kommer fra AUR."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Søk med «pamac search --aur <name>» og installer med «pamac build <name>»."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "For å hindre at en pakke oppgraderes, legg den til i IgnorePkg i /etc/pacman.conf."

msgid "“{command}” has no direct equivalent here."
msgstr "«{command}» har ingen direkte ekvivalent her."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Kjør «{tool} help» for å se kommandoene dette systemet forstår."

msgid "Tell which .deb file to install, for example: {example}"
msgstr "Oppgi hvilken .deb-fil som skal installeres, for eksempel: {example}"

msgid "This system uses pacman, not {tool}."
msgstr "Dette systemet bruker pacman, ikke {tool}."

