msgstr "Filer i en pakke"

msgid "Which package owns a file?"
msgstr "Hvilken pakke eier en fil?"

msgid "What can be upgraded"
msgstr "Hva kan oppgraderes"

msgid "Installed by you"
msgstr "Installert av deg"

msgid "Dependencies of a package"
msgstr "Avhengigheter til en pakke"

msgid "Who depends on a package"
msgstr "Hvem avhenger av en pakke"

msgid "Clean the download cache"
msgstr "Tøm nedlastingsbufferen"

