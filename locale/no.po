msgstr "Filen er ikke en Debian-pakke (debian-binary mangler)."

msgid "The Debian package has no control or data archive."
msgstr "Debian-pakken har ikke noe control- eller data-arkiv."

msgid "The Debian package has no control file."
msgstr "Debian-pakken har ingen control-fil."

msgid "The control file has no Package or Version field."
msgstr "Control-filen har ikke feltet Package eller Version."

msgid "Install .deb package"
msgstr "Installer .deb-pakke"

msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "Konverterer Debian-pakker til egne pacman-pakker og installerer dem."

msgid "Extracting files"
msgstr "Pakker ut filer"

msgid "Adapting folders to this system"
msgstr "Tilpasser mapper til dette systemet"

