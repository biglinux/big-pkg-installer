msgstr "ja"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "debtap-mod trenger ikke lenger en lokal database; ingenting å oppdatere."

msgid "no .deb file given"
msgstr "ingen .deb-fil oppgitt"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "valgene -s og -w er foreldet og ble ignorert"

