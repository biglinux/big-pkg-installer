msgstr "Αυτό το πακέτο δημιουργήθηκε για την αρχιτεκτονική {deb_arch}, αλλά το σύστημά σας είναι {host}."

msgid "Package"
msgstr "Πακέτο"

msgid "Package architecture"
msgstr "Αρχιτεκτονική πακέτου"

msgid "System architecture"
msgstr "Αρχιτεκτονική συστήματος"

msgid "This package cannot be installed on this computer. Look for a version of the package made for {host}."
msgstr "Αυτό το πακέτο δεν μπορεί να εγκατασταθεί σε αυτόν τον υπολογιστή. Αναζητήστε μια έκδοση του πακέτου για {host}."

msgid "This file cannot be installed"
msgstr "Αυτό το αρχείο δεν μπορεί να εγκατασταθεί"

msgid "The file may be damaged or is not a valid package. Download it again or check where it came from."
msgstr "Το αρχείο μπορεί να είναι κατεστραμμένο ή να μην είναι έγκυρο πακέτο. Κατεβάστε το ξανά ή ελέγξτε από πού προέρχεται."

msgid "Invalid file"
msgstr "Μη έγκυρο αρχείο"

msgid "The selected file is not a .deb or .rpm package."
msgstr "Το επιλεγμένο αρχείο δεν είναι πακέτο .deb ή .rpm."

msgid "This installer works only with .deb and .rpm files (packages for Debian, Ubuntu, Fedora, openSUSE and their derivatives)."
msgstr "Αυτό το πρόγραμμα εγκατάστασης λειτουργεί μόνο με αρχεία .deb και .rpm (πακέτα για Debian, Ubuntu, Fedora, openSUSE και τις παραγώγους τους)."

msgid "Choose a package file"
msgstr "Επιλογή αρχείου πακέτου"

msgid "Packages (.deb, .rpm)"
msgstr "Πακέτα (.deb, .rpm)"

