msgstr "Λίστα εγκατεστημένων"

msgid "Search installed"
msgstr "Αναζήτηση στα εγκατεστημένα"

msgid "Files of a package"
msgstr "Αρχεία ενός πακέτου"

msgid "Which package owns a file?"
msgstr "Ποιο πακέτο κατέχει ένα αρχείο;"

msgid "What can be upgraded"
msgstr "Τι μπορεί να αναβαθμιστεί"

msgid "Installed by you"
msgstr "Εγκατεστημένα από εσάς"

msgid "Dependencies of a package"
msgstr "Εξαρτήσεις ενός πακέτου"

msgid "Who depends on a package"
msgstr "Ποιοι εξαρτώνται από ένα πακέτο"

msgid "Clean the download cache"
msgstr "Εκκαθάριση της προσωρινής μνήμης λήψεων"

msgid "Add a repository / PPA"
msgstr "Προσθήκη αποθετηρίου / PPA"

msgid "(AUR)"
msgstr "(AUR)"

msgid "Command translator: {family} (Debian, Ubuntu, Mint, Fedora) to pacman and pamac (Arch, BigLinux, Manjaro)"
msgstr "Μεταφραστής εντολών: {family} (Debian, Ubuntu, Mint, Fedora) σε pacman και pamac (Arch, BigLinux, Manjaro)"

msgid "Both do the same job: install, update and remove programs. Only the commands change."
msgstr "Και τα δύο κάνουν την ίδια δουλειά: εγκατάσταση, ενημέρωση και αφαίρεση προγραμμάτων. Αλλάζουν μόνο οι εντολές."

msgid "You can keep typing {tool} commands: they are translated and run with pamac or pacman."
msgstr "Μπορείτε να συνεχίσετε να πληκτρολογείτε εντολές {tool}: μεταφράζονται και εκτελούνται με pamac ή pacman."

msgid "No command matches “{topic}”."
msgstr "Καμία εντολή δεν ταιριάζει με «{topic}»."

msgid "Run “{tool} help” to see every command."
msgstr "Εκτελέστε «{tool} help» για να δείτε όλες τις εντολές."

msgid "What you want to do"
msgstr "Τι θέλετε να κάνετε"

msgid "Differences that catch people"
msgstr "Διαφορές που μπερδεύουν"

msgid "apt update only refreshes the list; apt upgrade installs."
msgstr "Το apt update ανανεώνει μόνο τη λίστα· το apt upgrade εγκαθιστά."

msgid "In pacman, -Syu does both together."
msgstr "Στο pacman, το -Syu κάνει και τα δύο μαζί."

msgid "Avoid “pacman -Sy” alone: it can break the system."
msgstr "Αποφύγετε το «pacman -Sy» μόνο του: μπορεί να χαλάσει το σύστημα."

msgid "Package types"
msgstr "Τύποι πακέτων"

msgid "apt uses .deb files, dnf uses .rpm, pacman uses .pkg.tar.zst."
msgstr "Το apt χρησιμοποιεί αρχεία .deb, το dnf χρησιμοποιεί .rpm, το pacman χρησιμοποιεί .pkg.tar.zst."

msgid ".deb and .rpm files are converted and installed with big-pkg-installer (or a double click)."
msgstr "Τα αρχεία .deb και .rpm μετατρέπονται και εγκαθίστανται με το big-pkg-installer (ή με διπλό κλικ)."

msgid "Programs from the community"
msgstr "Προγράμματα της κοινότητας"

msgid "The AUR plays the role of PPAs and COPR."
msgstr "Το AUR παίζει το ρόλο των PPA και COPR."

msgid "Use “pamac build <name>”; never run AUR helpers with sudo."
msgstr "Χρησιμοποιήστε «pamac build <name>»· μην εκτελείτε ποτέ βοηθούς AUR με sudo."

msgid "Tip: “{tool} help install” shows only the lines about one command."
msgstr "Συμβουλή: το «{tool} help install» δείχνει μόνο τις γραμμές για μία εντολή."

msgid "Quick reference: “sudo” is needed to install or remove; searching and listing are not."
msgstr "Γρήγορη αναφορά: το «sudo» χρειάζεται για εγκατάσταση ή αφαίρεση· η αναζήτηση και η λίστα όχι."

msgid "Command not found: {cmd}"
msgstr "Η εντολή δεν βρέθηκε: {cmd}"

msgid "The package's own scripts only register a software repository and an AppArmor profile for other distributions; they are not needed here."
msgstr "Τα ίδια τα σενάρια του πακέτου απλώς καταχωρούν ένα αποθετήριο λογισμικού και ένα προφίλ AppArmor για άλλες διανομές· δεν χρειάζονται εδώ."

msgid "Unsupported RPM payload format."
msgstr "Μη υποστηριζόμενη μορφή φορτίου RPM."

msgid "The file is not an RPM package."
msgstr "Το αρχείο δεν είναι πακέτο RPM."

msgid "This is a source RPM (.src.rpm): it contains source code, not a program to install."
msgstr "Αυτό είναι RPM πηγαίου κώδικα (.src.rpm): περιέχει πηγαίο κώδικα, όχι πρόγραμμα προς εγκατάσταση."

msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "Το σενάριο {script} ρυθμίζει ένα αποθετήριο APT· αυτό το μέρος δεν έχει κανένα αποτέλεσμα σε αυτό το σύστημα."

msgid "The {script} script is written in Lua for RPM itself and was skipped."
msgstr "Το σενάριο {script} είναι γραμμένο σε Lua για το ίδιο το RPM και παραλείφθηκε."

msgid "The {script} script configures a DNF/YUM repository; that part has no effect on this system."
msgstr "Το σενάριο {script} ρυθμίζει ένα αποθετήριο DNF/YUM· αυτό το μέρος δεν έχει εφαρμογή σε αυτό το σύστημα."
