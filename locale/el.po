msgstr "Εξαγωγή αρχείων ({percent}%)"

msgid "Cancelled"
msgstr "Ακυρώθηκε"

msgid "The package could not be converted"
msgstr "Δεν ήταν δυνατή η μετατροπή του πακέτου"

msgid "Dependencies are not available"
msgstr "Οι εξαρτήσεις δεν είναι διαθέσιμες"

msgid "Some packages this program needs were not found in the repositories."
msgstr "Ορισμένα πακέτα που χρειάζεται αυτό το πρόγραμμα δεν βρέθηκαν στα αποθετήρια."

msgid "Installing the package"
msgstr "Εγκατάσταση του πακέτου"

msgid "Preparing the installation…"
msgstr "Προετοιμασία της εγκατάστασης…"

msgid "Downloading and installing dependencies…"
msgstr "Λήψη και εγκατάσταση εξαρτήσεων…"

msgid "Installing packages…"
msgstr "Εγκατάσταση πακέτων…"

msgid "Configuring the system…"
msgstr "Ρύθμιση του συστήματος…"

msgid "Finishing…"
msgstr "Ολοκλήρωση…"

msgid "Please wait until the installation finishes"
msgstr "Περιμένετε μέχρι να ολοκληρωθεί η εγκατάσταση"

msgid "Authorization was not granted"
msgstr "Η εξουσιοδότηση δεν δόθηκε"

msgid "The installation failed"
msgstr "Η εγκατάσταση απέτυχε"

msgid "An error happened while installing the package. See the details below."
msgstr "Παρουσιάστηκε σφάλμα κατά την εγκατάσταση του πακέτου. Δείτε τις λεπτομέρειες παρακάτω."

msgid "The application could not be started"
msgstr "Δεν ήταν δυνατή η εκκίνηση της εφαρμογής"

msgid "The RPM package is truncated or corrupted."
msgstr "Το πακέτο RPM είναι περικομμένο ή κατεστραμμένο."

msgid "makepkg cannot run as root; run big-pkg-installer as a regular user."
msgstr "Το makepkg δεν μπορεί να εκτελεστεί ως root· εκτελέστε το big-pkg-installer ως απλός χρήστης."

msgid "makepkg failed with exit code {code}"
msgstr "Το makepkg απέτυχε με κωδικό εξόδου {code}"

msgid "makepkg finished but produced no package"
msgstr "Το makepkg ολοκληρώθηκε αλλά δεν παρήγαγε πακέτο"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "Το «{typed}» ανανεώνει μόνο τη λίστα πακέτων. Εδώ το ασφαλές ισοδύναμο ελέγχει για ενημερώσεις χωρίς να εγκαταστήσει τίποτα· για να τις εγκαταστήσετε, χρησιμοποιήστε το «{upgrade}»."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Μην εκτελείτε ποτέ το «pacman -Sy» μόνο του: η ανανέωση χωρίς αναβάθμιση μπορεί να χαλάσει το σύστημα."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Το Arch δεν αναβαθμίζει μεμονωμένα πακέτα· ολόκληρο το σύστημα αναβαθμίζεται μαζί."

msgid "Tell which package to install, for example: {example}"
msgstr "Πείτε ποιο πακέτο να εγκατασταθεί, για παράδειγμα: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "Το pamac βρίσκει προγράμματα και στο AUR και στο Flatpak: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by big-pkg-installer."
msgstr "Τα πακέτα .deb και .rpm μετατρέπονται σε εγγενή πακέτα pacman από το big-pkg-installer."

msgid "Run this command as a regular user (without sudo)."
msgstr "Εκτελέστε αυτή την εντολή ως απλός χρήστης (χωρίς sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Πείτε ποιο πακέτο να αφαιρεθεί, για παράδειγμα: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "Το -n διαγράφει επίσης τα αρχεία ρυθμίσεων που εγκατέστησε το πακέτο στο /etc."

msgid "There are no orphan packages to remove."
msgstr "Δεν υπάρχουν ορφανά πακέτα για αφαίρεση."

msgid "Tell what to search for, for example: {example}"
msgstr "Πείτε τι να αναζητηθεί, για παράδειγμα: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Πείτε ποιο πακέτο, για παράδειγμα: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "Το πακέτο δεν είναι εγκατεστημένο· η λίστα προέρχεται από τη βάση δεδομένων αρχείων του αποθετηρίου."

msgid "Tell which file, for example: {example}"
msgstr "Πείτε ποιο αρχείο, για παράδειγμα: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Το αρχείο δεν υπάρχει σε αυτό το σύστημα· γίνεται αναζήτηση στη βάση δεδομένων αρχείων του αποθετηρίου."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Τα συστήματα βασισμένα στο Arch δεν έχουν PPA ή πρόσθετα αποθετήρια για προσθήκη. Τα προγράμματα της κοινότητας προέρχονται από το AUR."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Αναζητήστε με «pamac search --aur <name>» και εγκαταστήστε με «pamac build <name>»."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Για να μην αναβαθμίζεται ένα πακέτο, προσθέστε το στο IgnorePkg στο /etc/pacman.conf."

msgid "“{command}” has no direct equivalent here."
msgstr "Το «{command}» δεν έχει άμεσο ισοδύναμο εδώ."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Εκτελέστε «{tool} help» για να δείτε τις εντολές που καταλαβαίνει αυτό το σύστημα."

msgid "Tell which .deb file to install, for example: {example}"
msgstr "Πείτε ποιο αρχείο .deb να εγκατασταθεί, για παράδειγμα: {example}"

msgid "This system uses pacman, not {tool}."
msgstr "Αυτό το σύστημα χρησιμοποιεί pacman, όχι {tool}."

