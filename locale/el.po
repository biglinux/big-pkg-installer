msgid "Extracting package data"
msgstr "Εξαγωγή δεδομένων πακέτου"

msgid "Adapting the directory layout"
msgstr "Προσαρμογή της δομής καταλόγων"

msgid "Resolving dependencies"
msgstr "Επίλυση εξαρτήσεων"

msgid "Converting maintainer scripts"
msgstr "Μετατροπή των σεναρίων συντηρητή"

msgid "Building the pacman package"
msgstr "Δημιουργία του πακέτου pacman"

msgid "Warning:"
msgstr "Προειδοποίηση:"

msgid "Error:"
msgstr "Σφάλμα:"

msgid "Convert a .deb package into a pacman package and install it."
msgstr "Μετατρέπει ένα πακέτο .deb σε πακέτο pacman και το εγκαθιστά."

msgid "the .deb file"
msgstr "το αρχείο .deb"

msgid "do not ask questions, but open the install script for review"
msgstr "χωρίς ερωτήσεις, αλλά άνοιγμα του σεναρίου εγκατάστασης για έλεγχο"

msgid "do not ask any question"
msgstr "χωρίς καμία ερώτηση"

msgid "only build the package, do not install it"
msgstr "μόνο δημιουργία του πακέτου, χωρίς εγκατάσταση"

msgid "keep the built package in DIR"
msgstr "διατήρηση του πακέτου που δημιουργήθηκε στο DIR"

msgid "also write a PKGBUILD next to the .deb"
msgstr "εγγραφή και ενός PKGBUILD δίπλα στο .deb"

msgid "only write a PKGBUILD, do not build"
msgstr "μόνο εγγραφή ενός PKGBUILD, χωρίς δημιουργία"

msgid "{question} [y/N] "
msgstr "{question} [ν/Ο] "

msgid "yes"
msgstr "ναι"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "το debtap-mod δεν χρειάζεται πλέον τοπική βάση δεδομένων· δεν υπάρχει κάτι για ενημέρωση."

msgid "no .deb file given"
msgstr "δεν δόθηκε αρχείο .deb"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "οι επιλογές -s και -w έχουν καταργηθεί και αγνοήθηκαν"

msgid "Installed size: {size}"
msgstr "Εγκατεστημένο μέγεθος: {size}"

msgid "PKGBUILD written to {path}"
msgstr "Το PKGBUILD γράφτηκε στο {path}"

msgid "cancelled"
msgstr "ακυρώθηκε"

msgid "Package {file} built"
msgstr "Το πακέτο {file} δημιουργήθηκε"

msgid "Menu entries: {names}"
msgstr "Καταχωρίσεις μενού: {names}"

msgid "Package saved to {path}"
msgstr "Το πακέτο αποθηκεύτηκε στο {path}"

msgid "some files belong to other installed packages; remove them first:"
msgstr "ορισμένα αρχεία ανήκουν σε άλλα εγκατεστημένα πακέτα· αφαιρέστε τα πρώτα:"

msgid "Install script that will run as root:"
msgstr "Σενάριο εγκατάστασης που θα εκτελεστεί ως root:"

msgid "Install {name} now?"
msgstr "Εγκατάσταση του {name} τώρα;"

msgid "pacman could not install the package (exit code {code})"
msgstr "Το pacman δεν μπόρεσε να εγκαταστήσει το πακέτο (κωδικός εξόδου {code})"

msgid "{name} installed successfully"
msgstr "Το {name} εγκαταστάθηκε με επιτυχία"

msgid "Look for {names} in the applications menu."
msgstr "Αναζητήστε {names} στο μενού εφαρμογών."

msgid "This package was built for {deb_arch} but this computer is {host}; it will not run here."
msgstr "Αυτό το πακέτο δημιουργήθηκε για {deb_arch}, αλλά αυτός ο υπολογιστής είναι {host}· δεν θα λειτουργήσει εδώ."

msgid "Extracting {name}…"
msgstr "Εξαγωγή του {name}…"

msgid "Ignored unsafe or special entries: {list}"
msgstr "Αγνοήθηκαν μη ασφαλείς ή ειδικές εγγραφές: {list}"

msgid "Duplicate file kept from /usr: /{path}"
msgstr "Διατηρήθηκε διπλότυπο αρχείο από το /usr: /{path}"

msgid "Looking for dependencies…"
msgstr "Αναζήτηση εξαρτήσεων…"

msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "Αγνοήθηκαν {count} εκτελέσιμα που δημιουργήθηκαν για άλλα συστήματα ή αρχιτεκτονικές."

msgid "Libraries not found in the repositories: {list}"
msgstr "Βιβλιοθήκες που δεν βρέθηκαν στα αποθετήρια: {list}"

msgid "Debian dependencies without an equivalent here: {list}"
msgstr "Εξαρτήσεις Debian χωρίς αντίστοιχο εδώ: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "Αρχεία που ανήκουν ήδη σε άλλα πακέτα: {list}"

msgid "Building the package…"
msgstr "Δημιουργία του πακέτου…"

msgid "The file is not a Debian package (missing ar header)."
msgstr "Το αρχείο δεν είναι πακέτο Debian (λείπει η κεφαλίδα ar)."

msgid "The Debian package is truncated or corrupted."
msgstr "Το πακέτο Debian είναι κομμένο ή κατεστραμμένο."

msgid "Unsupported compression in member {name}."
msgstr "Μη υποστηριζόμενη συμπίεση στο μέλος {name}."

msgid "File not found: {path}"
msgstr "Το αρχείο δεν βρέθηκε: {path}"

msgid "The file is not a Debian package (debian-binary missing)."
msgstr "Το αρχείο δεν είναι πακέτο Debian (λείπει το debian-binary)."

msgid "The Debian package has no control or data archive."
msgstr "Το πακέτο Debian δεν έχει αρχείο control ή data."

msgid "The Debian package has no control file."
msgstr "Το πακέτο Debian δεν έχει αρχείο control."

msgid "The control file has no Package or Version field."
msgstr "Το αρχείο control δεν έχει πεδίο Package ή Version."

msgid "Install .deb package"
msgstr "Εγκατάσταση πακέτου .deb"

msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "Μετατρέπει πακέτα Debian σε εγγενή πακέτα pacman και τα εγκαθιστά."

msgid "Extracting files"
msgstr "Εξαγωγή αρχείων"

msgid "Adapting folders to this system"
msgstr "Προσαρμογή φακέλων σε αυτό το σύστημα"

msgid "Finding dependencies"
msgstr "Εύρεση εξαρτήσεων"

msgid "Preparing installation scripts"
msgstr "Προετοιμασία σεναρίων εγκατάστασης"

msgid "Building the package"
msgstr "Δημιουργία του πακέτου"

msgid "Waiting for authorization"
msgstr "Αναμονή για εξουσιοδότηση"

msgid "Installing"
msgstr "Εγκατάσταση"

msgid "About"
msgstr "Σχετικά"

msgid "Main menu"
msgstr "Κύριο μενού"

msgid "Choose a .deb file…"
msgstr "Επιλογή αρχείου .deb…"

msgid "Install a .deb package"
msgstr "Εγκατάσταση πακέτου .deb"

msgid "Open a Debian package or drop it here. It will be converted into a native package for this system and installed."
msgstr "Ανοίξτε ένα πακέτο Debian ή αφήστε το εδώ. Θα μετατραπεί σε εγγενές πακέτο για αυτό το σύστημα και θα εγκατασταθεί."

msgid "Details"
msgstr "Λεπτομέρειες"

msgid "Cancel"
msgstr "Ακύρωση"

msgid "Prefer native packages when available"
msgstr "Προτίμηση εγγενών πακέτων όταν είναι διαθέσιμα"

msgid "Programs from the system repositories, Flatpak or AppImage usually work better. Converted .deb packages may not work perfectly."
msgstr "Τα προγράμματα από τα αποθετήρια του συστήματος, το Flatpak ή το AppImage συνήθως λειτουργούν καλύτερα. Τα μετατρεπόμενα πακέτα .deb μπορεί να μη λειτουργούν τέλεια."

msgid "“{name}” is available in the repositories"
msgstr "Το «{name}» είναι διαθέσιμο στα αποθετήρια"

msgid "Installing the native package is recommended."
msgstr "Συνιστάται η εγκατάσταση του εγγενούς πακέτου."

msgid "Open"
msgstr "Άνοιγμα"

msgid "Package"
msgstr "Πακέτο"

msgid "Version"
msgstr "Έκδοση"

msgid "Architecture"
msgstr "Αρχιτεκτονική"

msgid "Installed size"
msgstr "Εγκατεστημένο μέγεθος"

msgid "Maintainer"
msgstr "Συντηρητής"

msgid "Website"
msgstr "Ιστότοπος"

msgid "Description"
msgstr "Περιγραφή"

msgid "Review before installing"
msgstr "Έλεγχος πριν την εγκατάσταση"

msgid "Show the dependencies and the scripts that will run as administrator"
msgstr "Εμφάνιση των εξαρτήσεων και των σεναρίων που θα εκτελεστούν ως διαχειριστής"

msgid "Install"
msgstr "Εγκατάσταση"

msgid "Ready to install"
msgstr "Έτοιμο για εγκατάσταση"

msgid "Check what will be installed."
msgstr "Ελέγξτε τι θα εγκατασταθεί."

msgid "Package name on this system"
msgstr "Όνομα πακέτου σε αυτό το σύστημα"

msgid "Package size"
msgstr "Μέγεθος πακέτου"

msgid "Applications menu"
msgstr "Μενού εφαρμογών"

msgid "No menu entry"
msgstr "Καμία καταχώριση μενού"

msgid "Warnings"
msgstr "Προειδοποιήσεις"

msgid "Notes"
msgstr "Σημειώσεις"

msgid "Dependencies"
msgstr "Εξαρτήσεις"

msgid "Required"
msgstr "Απαιτούμενες"

msgid "{n} package"
msgid_plural "{n} packages"
msgstr[0] "{n} πακέτο"
msgstr[1] "{n} πακέτα"

msgid "will be downloaded"
msgstr "θα γίνει λήψη"

msgid "Optional"
msgstr "Προαιρετικές"

msgid "Scripts"
msgstr "Σενάρια"

msgid "These commands from the Debian package run as administrator during installation."
msgstr "Αυτές οι εντολές από το πακέτο Debian εκτελούνται ως διαχειριστής κατά την εγκατάσταση."

msgid "Open {name}"
msgstr "Άνοιγμα του {name}"

msgid "Copy details"
msgstr "Αντιγραφή λεπτομερειών"

msgid "Close"
msgstr "Κλείσιμο"

msgid "This file cannot be installed"
msgstr "Αυτό το αρχείο δεν μπορεί να εγκατασταθεί"

msgid "Choose a .deb file"
msgstr "Επιλογή αρχείου .deb"

msgid "Debian packages"
msgstr "Πακέτα Debian"

msgid "Type your password in the window that will appear."
msgstr "Πληκτρολογήστε τον κωδικό πρόσβασής σας στο παράθυρο που θα εμφανιστεί."

msgid "Missing dependencies are downloaded from the repositories."
msgstr "Οι εξαρτήσεις που λείπουν λαμβάνονται από τα αποθετήρια."

msgid "Compressing the files, this may take a minute."
msgstr "Γίνεται συμπίεση των αρχείων, αυτό μπορεί να διαρκέσει ένα λεπτό."

msgid "The package could not be converted"
msgstr "Δεν ήταν δυνατή η μετατροπή του πακέτου"

msgid "Cancelled"
msgstr "Ακυρώθηκε"

msgid "{name} is installed"
msgstr "Το {name} είναι εγκατεστημένο"

msgid "The package {name} was installed. It has no entry in the applications menu."
msgstr "Το πακέτο {name} εγκαταστάθηκε. Δεν έχει καταχώριση στο μενού εφαρμογών."

msgid "Installation complete"
msgstr "Η εγκατάσταση ολοκληρώθηκε"

msgid "Authorization was not granted"
msgstr "Η εξουσιοδότηση δεν δόθηκε"

msgid "The installation failed"
msgstr "Η εγκατάσταση απέτυχε"

msgid "pacman returned an error (code {code}). Open the details to see what happened."
msgstr "Το pacman επέστρεψε σφάλμα (κωδικός {code}). Ανοίξτε τις λεπτομέρειες για να δείτε τι συνέβη."

msgid "The application could not be started"
msgstr "Δεν ήταν δυνατή η εκκίνηση της εφαρμογής"

msgid "Copied"
msgstr "Αντιγράφηκε"

msgid "Please wait until the installation finishes"
msgstr "Περιμένετε μέχρι να ολοκληρωθεί η εγκατάσταση"

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "Το makepkg δεν μπορεί να εκτελεστεί ως root· εκτελέστε το debtap-mod ως απλός χρήστης."

msgid "makepkg failed with exit code {code}"
msgstr "Το makepkg απέτυχε με κωδικό εξόδου {code}"

msgid "makepkg finished but produced no package"
msgstr "Το makepkg ολοκληρώθηκε αλλά δεν παρήγαγε πακέτο"

msgid "The Debian scripts only register an APT repository and an AppArmor profile for Ubuntu; they are not needed here."
msgstr "Τα σενάρια του Debian απλώς καταχωρούν ένα αποθετήριο APT και ένα προφίλ AppArmor για το Ubuntu· δεν χρειάζονται εδώ."

msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "Το σενάριο {script} ρυθμίζει ένα αποθετήριο APT· αυτό το μέρος δεν έχει κανένα αποτέλεσμα σε αυτό το σύστημα."
