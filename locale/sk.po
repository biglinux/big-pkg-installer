msgid "Incompatible package"
msgstr "Nekompatibilný balík"

msgid "This package was built for the {deb_arch} architecture, but your system is {host}."
msgstr "Tento balík bol zostavený pre architektúru {deb_arch}, ale váš systém je {host}."

msgid "Package"
msgstr "Balík"

msgid "Package architecture"
msgstr "Architektúra balíka"

msgid "System architecture"
msgstr "Architektúra systému"

msgid "This package cannot be installed on this computer. Look for a version of the package made for {host}."
msgstr "Tento balík nie je možné nainštalovať na tento počítač. Vyhľadajte verziu balíka vytvorenú pre {host}."

msgid "This file cannot be installed"
msgstr "Tento súbor sa nedá nainštalovať"

msgid "The file may be damaged or is not a valid package. Download it again or check where it came from."
msgstr "Súbor môže byť poškodený alebo nie je platným balíkom. Stiahnite ho znova alebo skontrolujte, odkiaľ pochádza."

msgid "Invalid file"
msgstr "Neplatný súbor"

msgid "The selected file is not a .deb or .rpm package."
msgstr "Vybraný súbor nie je balík .deb ani .rpm."

msgid "This installer works only with .deb and .rpm files (packages for Debian, Ubuntu, Fedora, openSUSE and their derivatives)."
msgstr "Tento inštalátor funguje iba so súbormi .deb a .rpm (balíky pre Debian, Ubuntu, Fedoru, openSUSE a ich deriváty)."

msgid "Choose a package file"
msgstr "Vyberte súbor balíka"

msgid "Packages (.deb, .rpm)"
msgstr "Balíky (.deb, .rpm)"

msgid "Preparing the package"
msgstr "Príprava balíka"

msgid "Extracting files ({percent}%)"
msgstr "Rozbaľovanie súborov ({percent} %)"

