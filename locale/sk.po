msgid "Extracting package data"
msgstr "Extrahovanie údajov balíka"

msgid "Adapting the directory layout"
msgstr "Prispôsobenie štruktúry priečinkov"

msgid "Resolving dependencies"
msgstr "Zisťovanie závislostí"

msgid "Converting maintainer scripts"
msgstr "Konverzia skriptov správcu balíka"

msgid "Building the pacman package"
msgstr "Zostavovanie balíka pacman"

msgid "Warning:"
msgstr "Upozornenie:"

msgid "Error:"
msgstr "Chyba:"

msgid "Convert a .deb package into a pacman package and install it."
msgstr "Skonvertuje balík .deb na balík pacman a nainštaluje ho."

msgid "the .deb file"
msgstr "súbor .deb"

msgid "do not ask questions, but open the install script for review"
msgstr "nekladať otázky, ale otvoriť inštalačný skript na kontrolu"

msgid "do not ask any question"
msgstr "nekladať žiadne otázky"

msgid "only build the package, do not install it"
msgstr "iba zostaviť balík, nenainštalovať ho"

msgid "keep the built package in DIR"
msgstr "uložiť zostavený balík do DIR"

msgid "also write a PKGBUILD next to the .deb"
msgstr "zapísať PKGBUILD vedľa súboru .deb"

msgid "only write a PKGBUILD, do not build"
msgstr "iba zapísať PKGBUILD, nezostavovať"

msgid "{question} [y/N] "
msgstr "{question} [a/N] "

msgid "yes"
msgstr "ano"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "debtap-mod už nepotrebuje lokálnu databázu; nie je čo aktualizovať."

msgid "no .deb file given"
msgstr "nebol zadaný žiadny súbor .deb"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "voľby -s a -w sú zastarané a boli ignorované"

msgid "Installed size: {size}"
msgstr "Inštalovaná veľkosť: {size}"

msgid "PKGBUILD written to {path}"
msgstr "PKGBUILD bol zapísaný do {path}"

msgid "cancelled"
msgstr "zrušené"

msgid "Package {file} built"
msgstr "Balík {file} bol zostavený"

msgid "Menu entries: {names}"
msgstr "Položky ponuky: {names}"

msgid "Package saved to {path}"
msgstr "Balík bol uložený do {path}"

msgid "some files belong to other installed packages; remove them first:"
msgstr "niektoré súbory patria iným nainštalovaným balíkom; najprv ich odstráňte:"

msgid "Install script that will run as root:"
msgstr "Inštalačný skript, ktorý sa spustí ako root:"

msgid "Install {name} now?"
msgstr "Nainštalovať {name} teraz?"

msgid "pacman could not install the package (exit code {code})"
msgstr "pacman nedokázal nainštalovať balík (návratový kód {code})"

msgid "{name} installed successfully"
msgstr "{name} bol úspešne nainštalovaný"

msgid "Look for {names} in the applications menu."
msgstr "Hľadajte {names} v ponuke aplikácií."

msgid "This package was built for {deb_arch} but this computer is {host}; it will not run here."
msgstr "Tento balík bol zostavený pre {deb_arch}, ale tento počítač je {host}; tu sa nespustí."

msgid "Extracting {name}…"
msgstr "Extrahuje sa {name}…"

msgid "Ignored unsafe or special entries: {list}"
msgstr "Ignorované nebezpečné alebo špeciálne položky: {list}"

msgid "Duplicate file kept from /usr: /{path}"
msgstr "Duplicitný súbor ponechaný z /usr: /{path}"

msgid "Looking for dependencies…"
msgstr "Hľadajú sa závislosti…"

msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "Ignorované binárne súbory pre iné systémy alebo architektúry: {count}."

msgid "Libraries not found in the repositories: {list}"
msgstr "Knižnice sa nenašli v repozitároch: {list}"

msgid "Debian dependencies without an equivalent here: {list}"
msgstr "Závislosti Debianu bez ekvivalentu v tomto systéme: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "Súbory, ktoré už vlastnia iné balíky: {list}"

msgid "Building the package…"
msgstr "Zostavuje sa balík…"

msgid "The file is not a Debian package (missing ar header)."
msgstr "Súbor nie je balík Debianu (chýba hlavička ar)."

msgid "The Debian package is truncated or corrupted."
msgstr "Balík Debianu je skrátený alebo poškodený."

msgid "Unsupported compression in member {name}."
msgstr "Nepodporovaná kompresia v člene {name}."

msgid "File not found: {path}"
msgstr "Súbor sa nenašiel: {path}"

msgid "The file is not a Debian package (debian-binary missing)."
msgstr "Súbor nie je balík Debianu (chýba debian-binary)."

msgid "The Debian package has no control or data archive."
msgstr "Balík Debianu neobsahuje archív control ani data."

msgid "The Debian package has no control file."
msgstr "Balík Debianu neobsahuje súbor control."

msgid "The control file has no Package or Version field."
msgstr "Súbor control neobsahuje pole Package ani Version."

msgid "Install .deb package"
msgstr "Inštalovať balík .deb"

msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "Konvertuje balíky Debianu na natívne balíky pacman a inštaluje ich."

msgid "Extracting files"
msgstr "Extrahovanie súborov"

msgid "Adapting folders to this system"
msgstr "Prispôsobenie priečinkov tomuto systému"

msgid "Finding dependencies"
msgstr "Hľadanie závislostí"

msgid "Preparing installation scripts"
msgstr "Príprava inštalačných skriptov"

msgid "Building the package"
msgstr "Zostavovanie balíka"

msgid "Waiting for authorization"
msgstr "Čaká sa na autorizáciu"

msgid "Installing"
msgstr "Inštalácia"

msgid "About"
msgstr "O aplikácii"

msgid "Main menu"
msgstr "Hlavná ponuka"

msgid "Choose a .deb file…"
msgstr "Vybrať súbor .deb…"

msgid "Install a .deb package"
msgstr "Inštalácia balíka .deb"

msgid "Open a Debian package or drop it here. It will be converted into a native package for this system and installed."
msgstr "Otvorte balík Debianu alebo ho sem presuňte. Bude skonvertovaný na natívny balík pre tento systém a nainštalovaný."

msgid "Details"
msgstr "Podrobnosti"

msgid "Cancel"
msgstr "Zrušiť"

msgid "Prefer native packages when available"
msgstr "Uprednostniť natívne balíky, ak sú dostupné"

msgid "Programs from the system repositories, Flatpak or AppImage usually work better. Converted .deb packages may not work perfectly."
msgstr "Programy zo systémových repozitárov, Flatpak alebo AppImage zvyčajne fungujú lepšie. Skonvertované balíky .deb nemusia fungovať dokonale."

msgid "“{name}” is available in the repositories"
msgstr "„{name}“ je dostupný v repozitároch"

msgid "Installing the native package is recommended."
msgstr "Odporúča sa nainštalovať natívny balík."

msgid "Open"
msgstr "Otvoriť"

msgid "Package"
msgstr "Balík"

msgid "Version"
msgstr "Verzia"

msgid "Architecture"
msgstr "Architektúra"

msgid "Installed size"
msgstr "Inštalovaná veľkosť"

msgid "Maintainer"
msgstr "Správca"

msgid "Website"
msgstr "Webová stránka"

msgid "Description"
msgstr "Popis"

msgid "Review before installing"
msgstr "Skontrolovať pred inštaláciou"

msgid "Show the dependencies and the scripts that will run as administrator"
msgstr "Zobraziť závislosti a skripty, ktoré sa spustia ako správca"

msgid "Install"
msgstr "Inštalovať"

msgid "Ready to install"
msgstr "Pripravené na inštaláciu"

msgid "Check what will be installed."
msgstr "Skontrolujte, čo sa nainštaluje."

msgid "Package name on this system"
msgstr "Názov balíka v tomto systéme"

msgid "Package size"
msgstr "Veľkosť balíka"

msgid "Applications menu"
msgstr "Ponuka aplikácií"

msgid "No menu entry"
msgstr "Žiadna položka v ponuke"

msgid "Warnings"
msgstr "Upozornenia"

msgid "Notes"
msgstr "Poznámky"

msgid "Dependencies"
msgstr "Závislosti"

msgid "Required"
msgstr "Povinné"

msgid "{n} package"
msgid_plural "{n} packages"
msgstr[0] "{n} balík"
msgstr[1] "{n} balíky"
msgstr[2] "{n} balíkov"

msgid "will be downloaded"
msgstr "sa stiahne"

msgid "Optional"
msgstr "Voliteľné"

msgid "Scripts"
msgstr "Skripty"

msgid "These commands from the Debian package run as administrator during installation."
msgstr "Tieto príkazy z balíka Debianu sa počas inštalácie spustia ako správca."

msgid "Open {name}"
msgstr "Otvoriť {name}"

msgid "Copy details"
msgstr "Kopírovať podrobnosti"

msgid "Close"
msgstr "Zavrieť"

msgid "This file cannot be installed"
msgstr "Tento súbor sa nedá nainštalovať"

msgid "Choose a .deb file"
msgstr "Vybrať súbor .deb"

msgid "Debian packages"
msgstr "Balíky Debianu"

msgid "Type your password in the window that will appear."
msgstr "Zadajte heslo v okne, ktoré sa zobrazí."

msgid "Missing dependencies are downloaded from the repositories."
msgstr "Chýbajúce závislosti sa stiahnu z repozitárov."

msgid "Compressing the files, this may take a minute."
msgstr "Súbory sa komprimujú, môže to chvíľu trvať."

msgid "The package could not be converted"
msgstr "Balík sa nepodarilo skonvertovať"

msgid "Cancelled"
msgstr "Zrušené"

msgid "{name} is installed"
msgstr "{name} je nainštalovaný"

msgid "The package {name} was installed. It has no entry in the applications menu."
msgstr "Balík {name} bol nainštalovaný. Nemá položku v ponuke aplikácií."

msgid "Installation complete"
msgstr "Inštalácia dokončená"

msgid "Authorization was not granted"
msgstr "Autorizácia nebola udelená"

msgid "The installation failed"
msgstr "Inštalácia zlyhala"

msgid "pacman returned an error (code {code}). Open the details to see what happened."
msgstr "pacman vrátil chybu (kód {code}). Podrobnosti zobrazíte po otvorení detailov."

msgid "The application could not be started"
msgstr "Aplikáciu sa nepodarilo spustiť"

msgid "Copied"
msgstr "Skopírované"

msgid "Please wait until the installation finishes"
msgstr "Počkajte, kým sa inštalácia dokončí"

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg sa nedá spustiť ako root; spustite debtap-mod ako bežný používateľ."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg zlyhal s kódom {code}"

msgid "makepkg finished but produced no package"
msgstr "makepkg skončil, ale nevytvoril žiadny balík"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "„{typed}“ iba obnoví zoznam balíkov. Bezpečný ekvivalent tu skontroluje aktualizácie bez inštalácie; na ich inštaláciu použite „{upgrade}“."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Nikdy nespúšťajte samotný „pacman -Sy“: obnovenie bez aktualizácie môže poškodiť systém."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch neaktualizuje jednotlivé balíky; celý systém sa aktualizuje naraz."

msgid "Tell which package to install, for example: {example}"
msgstr "Uveďte, ktorý balík nainštalovať, napríklad: {example}"

msgid ".rpm packages are made for Fedora/openSUSE and cannot be installed here."
msgstr "Balíky .rpm sú určené pre Fedoru/openSUSE a nedajú sa tu nainštalovať."

msgid "Look for the program in the repositories (pamac search), on Flathub, or as an AppImage."
msgstr "Hľadajte program v repozitároch (pamac search), na Flathube alebo ako AppImage."

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac nájde programy aj v AUR a Flatpaku: {cmd}"

msgid ".deb packages are converted into native pacman packages by debtap-mod."
msgstr "Balíky .deb sa pomocou debtap-mod prevedú na natívne balíky pacman."

msgid "Run this command as a regular user (without sudo)."
msgstr "Spustite tento príkaz ako bežný používateľ (bez sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Uveďte, ktorý balík odstrániť, napríklad: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n odstráni aj konfiguračné súbory, ktoré balík nainštaloval do /etc."

msgid "There are no orphan packages to remove."
msgstr "Nie sú žiadne osirelé balíky na odstránenie."

msgid "Tell what to search for, for example: {example}"
msgstr "Uveďte, čo hľadať, napríklad: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Uveďte, ktorý balík, napríklad: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "Balík nie je nainštalovaný; zoznam pochádza z databázy súborov repozitára."

msgid "Tell which file, for example: {example}"
msgstr "Uveďte, ktorý súbor, napríklad: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Súbor sa v tomto systéme nenachádza; prehľadáva sa databáza súborov repozitára."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Systémy založené na Arch nemajú PPA ani ďalšie repozitáre na pridanie. Programy od komunity pochádzajú z AUR."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Hľadajte pomocou „pamac search --aur <name>“ a inštalujte pomocou „pamac build <name>“."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Aby sa balík neaktualizoval, pridajte ho do IgnorePkg v /etc/pacman.conf."

msgid "“{command}” has no direct equivalent here."
msgstr "„{command}“ tu nemá priamy ekvivalent."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Spustite „{tool} help“ a zobrazia sa príkazy, ktorým tento systém rozumie."

msgid "Tell which .deb file to install, for example: {example}"
msgstr "Uveďte, ktorý súbor .deb nainštalovať, napríklad: {example}"

msgid "This system uses pacman, not {tool}."
msgstr "Tento systém používa pacman, nie {tool}."

msgid "You typed:"
msgstr "Zadali ste:"

msgid "Equivalent:"
msgstr "Ekvivalent:"

msgid "With pamac:"
msgstr "S pamac:"

msgid "Running:"
msgstr "Spúšťa sa:"

msgid "Update everything"
msgstr "Aktualizovať všetko"

msgid "Check for updates"
msgstr "Skontrolovať aktualizácie"

msgid "Install a program"
msgstr "Nainštalovať program"

msgid "Install a downloaded file"
msgstr "Nainštalovať stiahnutý súbor"

msgid "Install a .deb file here"
msgstr "Nainštalovať súbor .deb odtiaľto"

msgid "Reinstall"
msgstr "Preinštalovať"

msgid "Remove a program"
msgstr "Odstrániť program"

msgid "Remove + dependencies"
msgstr "Odstrániť + závislosti"

msgid "Remove + configuration"
msgstr "Odstrániť + konfiguráciu"

msgid "Remove orphans (unused)"
msgstr "Odstrániť osirelé (nepoužívané)"

msgid "Search to install"
msgstr "Hľadať na inštaláciu"

msgid "Details (available)"
msgstr "Podrobnosti (dostupné)"

msgid "Details (installed)"
msgstr "Podrobnosti (nainštalované)"

msgid "List everything available"
msgstr "Zobraziť všetko dostupné"

msgid "List installed"
msgstr "Zobraziť nainštalované"

msgid "Search installed"
msgstr "Hľadať v nainštalovaných"

msgid "Files of a package"
msgstr "Súbory balíka"

msgid "Which package owns a file?"
msgstr "Ktorý balík vlastní súbor?"

msgid "What can be upgraded"
msgstr "Čo sa dá aktualizovať"

msgid "Installed by you"
msgstr "Nainštalované vami"

msgid "Dependencies of a package"
msgstr "Závislosti balíka"

msgid "Who depends on a package"
msgstr "Kto závisí od balíka"

msgid "Clean the download cache"
msgstr "Vyčistiť vyrovnávaciu pamäť sťahovania"

msgid "Add a repository / PPA"
msgstr "Pridať repozitár / PPA"

msgid "(AUR)"
msgstr "(AUR)"

msgid "Command translator: {family} (Debian, Ubuntu, Mint, Fedora) to pacman and pamac (Arch, BigLinux, Manjaro)"
msgstr "Prekladač príkazov: {family} (Debian, Ubuntu, Mint, Fedora) na pacman a pamac (Arch, BigLinux, Manjaro)"

msgid "Both do the same job: install, update and remove programs. Only the commands change."
msgstr "Oba robia to isté: inštalujú, aktualizujú a odstraňujú programy. Líšia sa iba príkazy."

msgid "You can keep typing {tool} commands: they are translated and run with pamac or pacman."
msgstr "Príkazy {tool} môžete písať ďalej: preložia sa a spustia pomocou pamac alebo pacman."

msgid "No command matches “{topic}”."
msgstr "Žiadny príkaz nezodpovedá „{topic}“."

msgid "Run “{tool} help” to see every command."
msgstr "Spustite „{tool} help“ a zobrazia sa všetky príkazy."

msgid "What you want to do"
msgstr "Čo chcete urobiť"

msgid "Differences that catch people"
msgstr "Rozdiely, na ktorých sa ľudia zaseknú"

msgid "apt update only refreshes the list; apt upgrade installs."
msgstr "apt update iba obnoví zoznam; apt upgrade inštaluje."

msgid "In pacman, -Syu does both together."
msgstr "V pacman robí -Syu obe veci naraz."

msgid "Avoid “pacman -Sy” alone: it can break the system."
msgstr "Vyhnite sa samotnému „pacman -Sy“: môže poškodiť systém."

msgid "Package types"
msgstr "Typy balíkov"

msgid "apt uses .deb files, dnf uses .rpm, pacman uses .pkg.tar.zst."
msgstr "apt používa súbory .deb, dnf používa .rpm, pacman používa .pkg.tar.zst."

msgid ".deb files are converted and installed with debtap-mod (or a double click)."
msgstr "Súbory .deb sa prevedú a nainštalujú pomocou debtap-mod (alebo dvojitým kliknutím)."

msgid "Programs from the community"
msgstr "Programy od komunity"

msgid "The AUR plays the role of PPAs and COPR."
msgstr "AUR zastáva úlohu PPA a COPR."

msgid "Use “pamac build <name>”; never run AUR helpers with sudo."
msgstr "Použite „pamac build <name>“; pomocníkov AUR nikdy nespúšťajte so sudo."

msgid "Tip: “{tool} help install” shows only the lines about one command."
msgstr "Tip: „{tool} help install“ zobrazí iba riadky o jednom príkaze."

msgid "Quick reference: “sudo” is needed to install or remove; searching and listing are not."
msgstr "Rýchly prehľad: „sudo“ je potrebné na inštaláciu alebo odstránenie; na vyhľadávanie a zobrazenie zoznamu nie."

msgid "Command not found: {cmd}"
msgstr "Príkaz sa nenašiel: {cmd}"

msgid "The Debian scripts only register an APT repository and an AppArmor profile for Ubuntu; they are not needed here."
msgstr "Skripty Debianu iba registrujú repozitár APT a profil AppArmor pre Ubuntu; tu nie sú potrebné."

msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "Skript {script} nastavuje repozitár APT; táto časť nemá v tomto systéme žiadny účinok."
