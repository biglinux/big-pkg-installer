msgstr "Arhitektura sustava"

msgid "This package cannot be installed on this computer. Look for a version of the package made for {host}."
msgstr "Ovaj paket nije moguće instalirati na ovo računalo. Potražite verziju paketa izrađenu za {host}."

msgid "This file cannot be installed"
msgstr "Ova datoteka se ne može instalirati"

msgid "The file may be damaged or is not a valid package. Download it again or check where it came from."
msgstr "Datoteka je možda oštećena ili nije valjan paket. Preuzmite je ponovno ili provjerite odakle dolazi."

msgid "Invalid file"
msgstr "Nevaljana datoteka"

msgid "The selected file is not a .deb or .rpm package."
msgstr "Odabrana datoteka nije .deb ili .rpm paket."

msgid "This installer works only with .deb and .rpm files (packages for Debian, Ubuntu, Fedora, openSUSE and their derivatives)."
msgstr "Ovaj instalacijski program radi samo s .deb i .rpm datotekama (paketi za Debian, Ubuntu, Fedora, openSUSE i njihove derivate)."

msgid "Choose a package file"
msgstr "Odaberite datoteku paketa"

