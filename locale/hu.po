msgstr "A program működéséhez szükséges egyes csomagok nem találhatók a tárolókban."

msgid "Installing the package"
msgstr "A csomag telepítése"

msgid "Preparing the installation…"
msgstr "A telepítés előkészítése…"

msgid "Downloading and installing dependencies…"
msgstr "Függőségek letöltése és telepítése…"

msgid "Installing packages…"
msgstr "Csomagok telepítése…"

msgid "Configuring the system…"
msgstr "A rendszer beállítása…"

msgid "Finishing…"
msgstr "Befejezés…"

msgid "Please wait until the installation finishes"
msgstr "Várjon, amíg a telepítés befejeződik"

msgid "Authorization was not granted"
msgstr "A jogosultság megadása nem történt meg"

msgid "The installation failed"
msgstr "A telepítés sikertelen volt"

msgid "An error happened while installing the package. See the details below."
msgstr "Hiba történt a csomag telepítése közben. Az alábbiakban láthatók a részletek."

msgid "The application could not be started"
msgstr "Az alkalmazást nem sikerült elindítani"

msgid "The RPM package is truncated or corrupted."
msgstr "Az RPM csomag csonka vagy sérült."

msgid "makepkg cannot run as root; run big-pkg-installer as a regular user."
msgstr "a makepkg nem futtatható rootként; a big-pkg-installer-ot normál felhasználóként futtassa."

msgid "makepkg failed with exit code {code}"
msgstr "a makepkg sikertelen volt, kilépési kód: {code}"

msgid "makepkg finished but produced no package"
msgstr "a makepkg befejeződött, de nem hozott létre csomagot"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "A(z) “{typed}” csak a csomaglistát frissíti. Itt a biztonságos megfelelő telepítés nélkül ellenőrzi a frissítéseket; a telepítésükhöz használja a(z) “{upgrade}” parancsot."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Soha ne futtassa egyedül a “pacman -Sy” parancsot: a frissítés nélküli listafrissítés tönkreteheti a rendszert."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Az Arch nem frissít egyes csomagokat; a teljes rendszert együtt frissíti."

msgid "Tell which package to install, for example: {example}"
msgstr "Adja meg, melyik csomagot telepítse, például: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "A pamac az AUR-ban és a Flatpakban is talál programokat: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by big-pkg-installer."
msgstr "A .deb és .rpm csomagokat a big-pkg-installer alakítja át natív pacman csomagokká."

msgid "Run this command as a regular user (without sudo)."
msgstr "Futtassa ezt a parancsot hétköznapi felhasználóként (sudo nélkül)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Adja meg, melyik csomagot távolítsa el, például: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "A -n törli a csomag által az /etc könyvtárba telepített beállítófájlokat is."

msgid "There are no orphan packages to remove."
msgstr "Nincs eltávolítható árva csomag."

msgid "Tell what to search for, for example: {example}"
msgstr "Adja meg, mire keressen, például: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Adja meg, melyik csomagot, például: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "A csomag nincs telepítve; a lista a tárolók fájladatbázisából származik."

msgid "Tell which file, for example: {example}"
msgstr "Adja meg, melyik fájlt, például: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "A fájl nincs ezen a rendszeren; keresés a tárolók fájladatbázisában."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Az Arch-alapú rendszereken nincsenek PPA-k vagy hozzáadható extra tárolók. A közösségi programok az AUR-ból érkeznek."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Keressen így: “pamac search --aur <name>”, telepítsen így: “pamac build <name>”."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Ha meg akarja akadályozni egy csomag frissítését, adja hozzá az IgnorePkg listához az /etc/pacman.conf fájlban."

msgid "“{command}” has no direct equivalent here."
msgstr "A(z) “{command}” parancsnak itt nincs közvetlen megfelelője."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Futtassa a “{tool} help” parancsot a rendszer által értett parancsok megtekintéséhez."

msgid "Tell which .deb file to install, for example: {example}"
msgstr "Adja meg, melyik .deb fájlt telepítse, például: {example}"

msgid "This system uses pacman, not {tool}."
msgstr "Ez a rendszer pacmant használ, nem {tool} eszközt."

