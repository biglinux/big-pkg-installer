msgstr "Ez a csomag {deb_arch} architektúrához készült, de az Ön rendszere {host}."

msgid "Package"
msgstr "Csomag"

msgid "Package architecture"
msgstr "A csomag architektúrája"

msgid "System architecture"
msgstr "A rendszer architektúrája"

msgid "This package cannot be installed on this computer. Look for a version of the package made for {host}."
msgstr "Ez a csomag nem telepíthető erre a számítógépre. Keressen a {host} architektúrához készült verziót."

msgid "This file cannot be installed"
msgstr "Ez a fájl nem telepíthető"

msgid "The file may be damaged or is not a valid package. Download it again or check where it came from."
msgstr "A fájl sérült lehet, vagy nem érvényes csomag. Töltse le újra, vagy ellenőrizze a forrását."

msgid "Invalid file"
msgstr "Érvénytelen fájl"

msgid "The selected file is not a .deb or .rpm package."
msgstr "A kiválasztott fájl nem .deb vagy .rpm csomag."

msgid "This installer works only with .deb and .rpm files (packages for Debian, Ubuntu, Fedora, openSUSE and their derivatives)."
msgstr "Ez a telepítő csak .deb és .rpm fájlokkal működik (Debian, Ubuntu, Fedora, openSUSE és származékaik csomagjai)."

