msgid "Extracting package data"
msgstr "Csomagadatok kibontása"

msgid "Adapting the directory layout"
msgstr "A könyvtárszerkezet átalakítása"

msgid "Resolving dependencies"
msgstr "Függőségek feloldása"

msgid "Converting maintainer scripts"
msgstr "Karbantartói szkriptek átalakítása"

msgid "Building the pacman package"
msgstr "A pacman csomag építése"

msgid "Warning:"
msgstr "Figyelmeztetés:"

msgid "Error:"
msgstr "Hiba:"

msgid "Convert a .deb package into a pacman package and install it."
msgstr "Egy .deb csomag átalakítása pacman csomaggá és telepítése."

msgid "the .deb file"
msgstr "a .deb fájl"

msgid "do not ask questions, but open the install script for review"
msgstr "ne tegyen fel kérdéseket, de nyissa meg a telepítőszkriptet átnézésre"

msgid "do not ask any question"
msgstr "ne tegyen fel kérdéseket"

msgid "only build the package, do not install it"
msgstr "csak építse meg a csomagot, ne telepítse"

msgid "keep the built package in DIR"
msgstr "az elkészült csomag megtartása a DIR könyvtárban"

msgid "also write a PKGBUILD next to the .deb"
msgstr "PKGBUILD írása a .deb mellé is"

msgid "only write a PKGBUILD, do not build"
msgstr "csak PKGBUILD írása, építés nélkül"

msgid "{question} [y/N] "
msgstr "{question} [i/N] "

msgid "yes"
msgstr "igen"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "a debtap-mod-nak már nincs szüksége helyi adatbázisra; nincs mit frissíteni."

msgid "no .deb file given"
msgstr "nincs megadva .deb fájl"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "a -s és -w kapcsolók elavultak, és figyelmen kívül lettek hagyva"

msgid "Installed size: {size}"
msgstr "Telepített méret: {size}"

msgid "PKGBUILD written to {path}"
msgstr "A PKGBUILD ide lett írva: {path}"

msgid "cancelled"
msgstr "megszakítva"

msgid "Package {file} built"
msgstr "A(z) {file} csomag elkészült"

msgid "Menu entries: {names}"
msgstr "Menübejegyzések: {names}"

msgid "Package saved to {path}"
msgstr "A csomag mentve ide: {path}"

msgid "some files belong to other installed packages; remove them first:"
msgstr "néhány fájl más telepített csomagokhoz tartozik; először távolítsa el őket:"

msgid "Install script that will run as root:"
msgstr "Telepítőszkript, amely rootként fog futni:"

msgid "Install {name} now?"
msgstr "Telepíti most: {name}?"

msgid "pacman could not install the package (exit code {code})"
msgstr "a pacman nem tudta telepíteni a csomagot (kilépési kód: {code})"

msgid "{name} installed successfully"
msgstr "A(z) {name} telepítése sikerült"

msgid "Look for {names} in the applications menu."
msgstr "Keresse ezt az alkalmazásmenüben: {names}."

msgid "This package was built for {deb_arch} but this computer is {host}; it will not run here."
msgstr "Ez a csomag a(z) {deb_arch} architektúrára készült, de ez a számítógép {host}; itt nem fog futni."

msgid "Extracting {name}…"
msgstr "{name} kibontása…"

msgid "Ignored unsafe or special entries: {list}"
msgstr "Figyelmen kívül hagyott nem biztonságos vagy speciális bejegyzések: {list}"

msgid "Duplicate file kept from /usr: /{path}"
msgstr "Duplikált fájl megtartva a /usr könyvtárból: /{path}"

msgid "Looking for dependencies…"
msgstr "Függőségek keresése…"

msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "{count} más rendszerre vagy architektúrára készült bináris figyelmen kívül hagyva."

msgid "Libraries not found in the repositories: {list}"
msgstr "A tárolókban nem található könyvtárak: {list}"

msgid "Debian dependencies without an equivalent here: {list}"
msgstr "Debian-függőségek, amelyeknek itt nincs megfelelője: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "Más csomagok tulajdonában lévő fájlok: {list}"

msgid "Building the package…"
msgstr "A csomag építése…"

msgid "The file is not a Debian package (missing ar header)."
msgstr "A fájl nem Debian-csomag (hiányzik az ar fejléc)."

msgid "The Debian package is truncated or corrupted."
msgstr "A Debian-csomag csonka vagy sérült."

msgid "Unsupported compression in member {name}."
msgstr "Nem támogatott tömörítés a(z) {name} elemben."

msgid "File not found: {path}"
msgstr "A fájl nem található: {path}"

msgid "The file is not a Debian package (debian-binary missing)."
msgstr "A fájl nem Debian-csomag (hiányzik a debian-binary)."

msgid "The Debian package has no control or data archive."
msgstr "A Debian-csomagban nincs control vagy data archívum."

msgid "The Debian package has no control file."
msgstr "A Debian-csomagban nincs control fájl."

msgid "The control file has no Package or Version field."
msgstr "A control fájlból hiányzik a Package vagy a Version mező."

msgid "Install .deb package"
msgstr ".deb csomag telepítése"

msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "Debian-csomagokat alakít át natív pacman csomagokká, és telepíti őket."

msgid "Extracting files"
msgstr "Fájlok kibontása"

msgid "Adapting folders to this system"
msgstr "Mappák igazítása ehhez a rendszerhez"

msgid "Finding dependencies"
msgstr "Függőségek keresése"

msgid "Preparing installation scripts"
msgstr "Telepítőszkriptek előkészítése"

msgid "Building the package"
msgstr "A csomag építése"

msgid "Waiting for authorization"
msgstr "Várakozás a jogosultságra"

msgid "Installing"
msgstr "Telepítés"

msgid "About"
msgstr "Névjegy"

msgid "Main menu"
msgstr "Főmenü"

msgid "Choose a .deb file…"
msgstr "Válasszon egy .deb fájlt…"

msgid "Install a .deb package"
msgstr "Egy .deb csomag telepítése"

msgid "Open a Debian package or drop it here. It will be converted into a native package for this system and installed."
msgstr "Nyisson meg egy Debian-csomagot, vagy húzza ide. A rendszer natív csomaggá alakítja és telepíti."

msgid "Details"
msgstr "Részletek"

msgid "Cancel"
msgstr "Mégse"

msgid "Prefer native packages when available"
msgstr "Natív csomagok előnyben részesítése, ha elérhetők"

msgid "Programs from the system repositories, Flatpak or AppImage usually work better. Converted .deb packages may not work perfectly."
msgstr "A rendszertárolókból, a Flatpakből vagy AppImage-ből származó programok általában jobban működnek. Az átalakított .deb csomagok nem biztos, hogy tökéletesen működnek."

msgid "“{name}” is available in the repositories"
msgstr "A(z) „{name}” elérhető a tárolókban"

msgid "Installing the native package is recommended."
msgstr "A natív csomag telepítése ajánlott."

msgid "Open"
msgstr "Megnyitás"

msgid "Package"
msgstr "Csomag"

msgid "Version"
msgstr "Verzió"

msgid "Architecture"
msgstr "Architektúra"

msgid "Installed size"
msgstr "Telepített méret"

msgid "Maintainer"
msgstr "Karbantartó"

msgid "Website"
msgstr "Weboldal"

msgid "Description"
msgstr "Leírás"

msgid "Review before installing"
msgstr "Áttekintés telepítés előtt"

msgid "Show the dependencies and the scripts that will run as administrator"
msgstr "A függőségek és a rendszergazdaként futó szkriptek megjelenítése"

msgid "Install"
msgstr "Telepítés"

msgid "Ready to install"
msgstr "Készen áll a telepítésre"

msgid "Check what will be installed."
msgstr "Ellenőrizze, mi fog települni."

msgid "Package name on this system"
msgstr "Csomagnév ezen a rendszeren"

msgid "Package size"
msgstr "Csomagméret"

msgid "Applications menu"
msgstr "Alkalmazásmenü"

msgid "No menu entry"
msgstr "Nincs menübejegyzés"

msgid "Warnings"
msgstr "Figyelmeztetések"

msgid "Notes"
msgstr "Megjegyzések"

msgid "Dependencies"
msgstr "Függőségek"

msgid "Required"
msgstr "Kötelező"

msgid "{n} package"
msgid_plural "{n} packages"
msgstr[0] "{n} csomag"
msgstr[1] "{n} csomag"

msgid "will be downloaded"
msgstr "letöltésre kerül"

msgid "Optional"
msgstr "Választható"

msgid "Scripts"
msgstr "Szkriptek"

msgid "These commands from the Debian package run as administrator during installation."
msgstr "A Debian-csomag ezen parancsai rendszergazdaként futnak a telepítés során."

msgid "Open {name}"
msgstr "{name} megnyitása"

msgid "Copy details"
msgstr "Részletek másolása"

msgid "Close"
msgstr "Bezárás"

msgid "This file cannot be installed"
msgstr "Ez a fájl nem telepíthető"

msgid "Choose a .deb file"
msgstr "Válasszon egy .deb fájlt"

msgid "Debian packages"
msgstr "Debian-csomagok"

msgid "Type your password in the window that will appear."
msgstr "Írja be a jelszavát a megjelenő ablakban."

msgid "Missing dependencies are downloaded from the repositories."
msgstr "A hiányzó függőségek letöltődnek a tárolókból."

msgid "Compressing the files, this may take a minute."
msgstr "A fájlok tömörítése folyamatban, ez eltarthat egy percig."

msgid "The package could not be converted"
msgstr "A csomagot nem sikerült átalakítani"

msgid "Cancelled"
msgstr "Megszakítva"

msgid "{name} is installed"
msgstr "A(z) {name} telepítve van"

msgid "The package {name} was installed. It has no entry in the applications menu."
msgstr "A(z) {name} csomag telepítve lett. Nincs bejegyzése az alkalmazásmenüben."

msgid "Installation complete"
msgstr "A telepítés befejeződött"

msgid "Authorization was not granted"
msgstr "A jogosultság megadása nem történt meg"

msgid "The installation failed"
msgstr "A telepítés sikertelen volt"

msgid "pacman returned an error (code {code}). Open the details to see what happened."
msgstr "A pacman hibát jelzett (kód: {code}). Nyissa meg a részleteket, hogy lássa, mi történt."

msgid "The application could not be started"
msgstr "Az alkalmazást nem sikerült elindítani"

msgid "Copied"
msgstr "Másolva"

msgid "Please wait until the installation finishes"
msgstr "Várjon, amíg a telepítés befejeződik"

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "a makepkg nem futtatható rootként; a debtap-mod-ot normál felhasználóként futtassa."

msgid "makepkg failed with exit code {code}"
msgstr "a makepkg sikertelen volt, kilépési kód: {code}"

msgid "makepkg finished but produced no package"
msgstr "a makepkg befejeződött, de nem hozott létre csomagot"

msgid "The Debian scripts only register an APT repository and an AppArmor profile for Ubuntu; they are not needed here."
msgstr "A Debian-szkriptek csak egy APT-tárolót és egy AppArmor-profilt regisztrálnak Ubuntuhoz; itt nincs rájuk szükség."

msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "A(z) {script} szkript egy APT-tárolót állít be; ennek a résznek nincs hatása ezen a rendszeren."
