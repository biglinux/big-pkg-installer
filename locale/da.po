msgstr "Dubleret fil bevaret fra /usr: /{path}"

msgid "Looking for dependencies…"
msgstr "Leder efter afhængigheder…"

msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "Ignorerede {count} binære filer bygget til andre systemer eller arkitekturer."

msgid "Libraries not found in the repositories: {list}"
msgstr "Biblioteker, der ikke blev fundet i arkiverne: {list}"

msgid "Debian dependencies without an equivalent here: {list}"
msgstr "Debian-afhængigheder uden tilsvarende her: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "Filer, der allerede tilhører andre pakker: {list}"

msgid "Building the package…"
msgstr "Bygger pakken…"

msgid "The file is not a Debian package (missing ar header)."
msgstr "Filen er ikke en Debian-pakke (ar-header mangler)."

msgid "The Debian package is truncated or corrupted."
msgstr "Debian-pakken er afkortet eller beskadiget."

msgid "Unsupported compression in member {name}."
msgstr "Komprimeringen i delen {name} understøttes ikke."

msgid "File not found: {path}"
msgstr "Filen blev ikke fundet: {path}"

msgid "The file is not a Debian package (debian-binary missing)."
msgstr "Filen er ikke en Debian-pakke (debian-binary mangler)."

msgid "The Debian package has no control or data archive."
msgstr "Debian-pakken har intet control- eller data-arkiv."

msgid "The Debian package has no control file."
msgstr "Debian-pakken har ingen control-fil."

msgid "The control file has no Package or Version field."
msgstr "Control-filen har intet Package- eller Version-felt."

msgid "Install .deb package"
msgstr "Installér .deb-pakke"

msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "Konverterer Debian-pakker til native pacman-pakker og installerer dem."

msgid "Extracting files"
msgstr "Udpakker filer"

msgid "Adapting folders to this system"
msgstr "Tilpasser mapper til dette system"

