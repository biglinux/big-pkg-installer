msgstr "Venter på godkendelse"

msgid "Installing"
msgstr "Installerer"

msgid "About"
msgstr "Om"

msgid "Main menu"
msgstr "Hovedmenu"

msgid "Choose a .deb file…"
msgstr "Vælg en .deb-fil…"

msgid "Install a .deb package"
msgstr "Installér en .deb-pakke"

msgid "Open a Debian package or drop it here. It will be converted into a native package for this system and installed."
msgstr "Åbn en Debian-pakke, eller slip den her. Den konverteres til en native pakke til dette system og installeres."

msgid "Details"
msgstr "Detaljer"

msgid "Cancel"
msgstr "Annullér"

msgid "Prefer native packages when available"
msgstr "Foretræk native pakker, når de er tilgængelige"

msgid "Programs from the system repositories, Flatpak or AppImage usually work better. Converted .deb packages may not work perfectly."
msgstr "Programmer fra systemets arkiver, Flatpak eller AppImage fungerer som regel bedre. Konverterede .deb-pakker fungerer måske ikke perfekt."

msgid "“{name}” is available in the repositories"
msgstr "»{name}« findes i arkiverne"

msgid "Installing the native package is recommended."
msgstr "Det anbefales at installere den native pakke."

msgid "Open"
msgstr "Åbn"

msgid "Package"
msgstr "Pakke"

msgid "Version"
msgstr "Version"

