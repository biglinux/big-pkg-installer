msgstr "ja"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "debtap-mod behøver ikke længere en lokal database; intet at opdatere."

msgid "no .deb file given"
msgstr "ingen .deb-fil angivet"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "tilvalgene -s og -w er forældede og blev ignoreret"

