msgstr "makepkg blev færdig, men lavede ingen pakke"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "“{typed}” opdaterer kun pakkelisten. Her kontrollerer den sikre ækvivalent for opdateringer uden at installere noget; brug “{upgrade}” for at installere dem."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Kør aldrig “pacman -Sy” alene: at opdatere listen uden at opgradere kan ødelægge systemet."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch opgraderer ikke enkelte pakker; hele systemet opgraderes samlet."

msgid "Tell which package to install, for example: {example}"
msgstr "Angiv hvilken pakke der skal installeres, for eksempel: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac finder også programmer i AUR og Flatpak: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by big-pkg-installer."
msgstr ".deb- og .rpm-pakker konverteres til indbyggede pacman-pakker af big-pkg-installer."

msgid "Run this command as a regular user (without sudo)."
msgstr "Kør denne kommando som almindelig bruger (uden sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Angiv hvilken pakke der skal fjernes, for eksempel: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n sletter også de konfigurationsfiler, som pakken installerede i /etc."

msgid "There are no orphan packages to remove."
msgstr "Der er ingen forældreløse pakker at fjerne."

msgid "Tell what to search for, for example: {example}"
msgstr "Angiv hvad der skal søges efter, for eksempel: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Angiv hvilken pakke, for eksempel: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "Pakken er ikke installeret; listen kommer fra arkivets fildatabase."

msgid "Tell which file, for example: {example}"
msgstr "Angiv hvilken fil, for eksempel: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Filen findes ikke på dette system; der søges i arkivets fildatabase."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Arch-baserede systemer har ingen PPA'er eller ekstra arkiver at tilføje. Programmer fra fællesskabet kommer fra AUR."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Søg med “pamac search --aur <name>” og installér med “pamac build <name>”."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "For at forhindre en pakke i at blive opgraderet, tilføj den til IgnorePkg i /etc/pacman.conf."

msgid "“{command}” has no direct equivalent here."
msgstr "“{command}” har ingen direkte ækvivalent her."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Kør “{tool} help” for at se de kommandoer, dette system forstår."

