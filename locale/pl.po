msgstr "Ten pakiet został zbudowany dla architektury {deb_arch}, a Twój system to {host}."

msgid "Package"
msgstr "Pakiet"

msgid "Package architecture"
msgstr "Architektura pakietu"

msgid "System architecture"
msgstr "Architektura systemu"

msgid "This package cannot be installed on this computer. Look for a version of the package made for {host}."
msgstr "Tego pakietu nie można zainstalować na tym komputerze. Poszukaj wersji pakietu przygotowanej dla {host}."

msgid "This file cannot be installed"
msgstr "Tego pliku nie można zainstalować"

msgid "The file may be damaged or is not a valid package. Download it again or check where it came from."
msgstr "Plik może być uszkodzony lub nie jest prawidłowym pakietem. Pobierz go ponownie lub sprawdź, skąd pochodzi."

msgid "Invalid file"
msgstr "Nieprawidłowy plik"

msgid "The selected file is not a .deb or .rpm package."
msgstr "Wybrany plik nie jest pakietem .deb ani .rpm."

msgid "This installer works only with .deb and .rpm files (packages for Debian, Ubuntu, Fedora, openSUSE and their derivatives)."
msgstr "Ten instalator działa tylko z plikami .deb i .rpm (pakiety dla Debiana, Ubuntu, Fedory, openSUSE i ich pochodnych)."

msgid "Choose a package file"
msgstr "Wybierz plik pakietu"

