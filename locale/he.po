msgid "Extracting package data"
msgstr "מחלץ את נתוני החבילה"

msgid "Adapting the directory layout"
msgstr "מתאים את מבנה התיקיות"

msgid "Resolving dependencies"
msgstr "פותר תלויות"

msgid "Converting maintainer scripts"
msgstr "ממיר את סקריפטי המתחזק"

msgid "Building the pacman package"
msgstr "בונה את חבילת pacman"

msgid "Warning:"
msgstr "אזהרה:"

msgid "Error:"
msgstr "שגיאה:"

msgid "Convert a .deb package into a pacman package and install it."
msgstr "ממיר חבילת .deb לחבילת pacman ומתקין אותה."

msgid "the .deb file"
msgstr "קובץ ה-.deb"

msgid "do not ask questions, but open the install script for review"
msgstr "לא לשאול שאלות, אבל לפתוח את סקריפט ההתקנה לבדיקה"

msgid "do not ask any question"
msgstr "לא לשאול שום שאלה"

msgid "only build the package, do not install it"
msgstr "רק לבנות את החבילה, בלי להתקין אותה"

msgid "keep the built package in DIR"
msgstr "לשמור את החבילה שנבנתה ב-DIR"

msgid "also write a PKGBUILD next to the .deb"
msgstr "לכתוב גם PKGBUILD לצד קובץ ה-.deb"

msgid "only write a PKGBUILD, do not build"
msgstr "לכתוב PKGBUILD בלבד, בלי לבנות"

msgid "{question} [y/N] "
msgstr "{question} [כ/ל] "

msgid "yes"
msgstr "כן"

msgid "debtap-mod no longer needs a local database; nothing to update."
msgstr "debtap-mod כבר לא צריך מסד נתונים מקומי; אין מה לעדכן."

msgid "no .deb file given"
msgstr "לא צוין קובץ .deb"

msgid "the -s and -w options are obsolete and were ignored"
msgstr "האפשרויות ‎-s ו-‎-w מיושנות והן הוזנחו"

msgid "Installed size: {size}"
msgstr "גודל מותקן: {size}"

msgid "PKGBUILD written to {path}"
msgstr "PKGBUILD נכתב אל {path}"

msgid "cancelled"
msgstr "בוטל"

msgid "Package {file} built"
msgstr "החבילה {file} נבנתה"

msgid "Menu entries: {names}"
msgstr "פריטי תפריט: {names}"

msgid "Package saved to {path}"
msgstr "החבילה נשמרה ב-{path}"

msgid "some files belong to other installed packages; remove them first:"
msgstr "חלק מהקבצים שייכים לחבילות מותקנות אחרות; יש להסיר אותם קודם:"

msgid "Install script that will run as root:"
msgstr "סקריפט ההתקנה שירוץ כ-root:"

msgid "Install {name} now?"
msgstr "להתקין את {name} עכשיו?"

msgid "pacman could not install the package (exit code {code})"
msgstr "pacman לא הצליח להתקין את החבילה (קוד יציאה {code})"

msgid "{name} installed successfully"
msgstr "{name} הותקנה בהצלחה"

msgid "Look for {names} in the applications menu."
msgstr "חפשו את {names} בתפריט היישומים."

msgid "This package was built for {deb_arch} but this computer is {host}; it will not run here."
msgstr "חבילה זו נבנתה עבור {deb_arch}, אבל המחשב הזה הוא {host}; היא לא תרוץ כאן."

msgid "Extracting {name}…"
msgstr "מחלץ את {name}…"

msgid "Ignored unsafe or special entries: {list}"
msgstr "רשומות לא בטוחות או מיוחדות הוזנחו: {list}"

msgid "Duplicate file kept from /usr: /{path}"
msgstr "קובץ כפול נשמר מתוך /usr‎: /{path}"

msgid "Looking for dependencies…"
msgstr "מחפש תלויות…"

msgid "Ignored {count} binaries built for other systems or architectures."
msgstr "{count} קבצים בינאריים שנבנו עבור מערכות או ארכיטקטורות אחרות הוזנחו."

msgid "Libraries not found in the repositories: {list}"
msgstr "ספריות שלא נמצאו במאגרים: {list}"

msgid "Debian dependencies without an equivalent here: {list}"
msgstr "תלויות Debian ללא מקבילה כאן: {list}"

msgid "Files already owned by other packages: {list}"
msgstr "קבצים שכבר שייכים לחבילות אחרות: {list}"

msgid "Building the package…"
msgstr "בונה את החבילה…"

msgid "The file is not a Debian package (missing ar header)."
msgstr "הקובץ אינו חבילת Debian (כותרת ar חסרה)."

msgid "The Debian package is truncated or corrupted."
msgstr "חבילת Debian קטועה או פגומה."

msgid "Unsupported compression in member {name}."
msgstr "דחיסה לא נתמכת ברכיב {name}."

msgid "File not found: {path}"
msgstr "הקובץ לא נמצא: {path}"

msgid "The file is not a Debian package (debian-binary missing)."
msgstr "הקובץ אינו חבילת Debian (debian-binary חסר)."

msgid "The Debian package has no control or data archive."
msgstr "בחבילת Debian אין ארכיון control או data."

msgid "The Debian package has no control file."
msgstr "בחבילת Debian אין קובץ control."

msgid "The control file has no Package or Version field."
msgstr "בקובץ control אין שדה Package או Version."

msgid "Install .deb package"
msgstr "התקנת חבילת .deb"

msgid "Converts Debian packages into native pacman packages and installs them."
msgstr "ממיר חבילות Debian לחבילות pacman מקוריות ומתקין אותן."

msgid "Extracting files"
msgstr "מחלץ קבצים"

msgid "Adapting folders to this system"
msgstr "מתאים תיקיות למערכת הזו"

msgid "Finding dependencies"
msgstr "מחפש תלויות"

msgid "Preparing installation scripts"
msgstr "מכין סקריפטי התקנה"

msgid "Building the package"
msgstr "בונה את החבילה"

msgid "Waiting for authorization"
msgstr "ממתין לאישור"

msgid "Installing"
msgstr "מתקין"

msgid "About"
msgstr "אודות"

msgid "Main menu"
msgstr "תפריט ראשי"

msgid "Choose a .deb file…"
msgstr "בחירת קובץ .deb…"

msgid "Install a .deb package"
msgstr "התקנת חבילת .deb"

msgid "Open a Debian package or drop it here. It will be converted into a native package for this system and installed."
msgstr "פתחו חבילת Debian או גררו אותה לכאן. היא תומר לחבילה מקורית של המערכת הזו ותותקן."

msgid "Details"
msgstr "פרטים"

msgid "Cancel"
msgstr "ביטול"

msgid "Prefer native packages when available"
msgstr "להעדיף חבילות מקוריות כשהן זמינות"

msgid "Programs from the system repositories, Flatpak or AppImage usually work better. Converted .deb packages may not work perfectly."
msgstr "תוכנות ממאגרי המערכת, Flatpak או AppImage בדרך כלל עובדות טוב יותר. חבילות .deb שהומרו עשויות שלא לעבוד בצורה מושלמת."

msgid "“{name}” is available in the repositories"
msgstr "“{name}” זמינה במאגרים"

msgid "Installing the native package is recommended."
msgstr "מומלץ להתקין את החבילה המקורית."

msgid "Open"
msgstr "פתיחה"

msgid "Package"
msgstr "חבילה"

msgid "Version"
msgstr "גרסה"

msgid "Architecture"
msgstr "ארכיטקטורה"

msgid "Installed size"
msgstr "גודל מותקן"

msgid "Maintainer"
msgstr "מתחזק"

msgid "Website"
msgstr "אתר"

msgid "Description"
msgstr "תיאור"

msgid "Review before installing"
msgstr "בדיקה לפני ההתקנה"

msgid "Show the dependencies and the scripts that will run as administrator"
msgstr "מציג את התלויות ואת הסקריפטים שירוצו כמנהל"

msgid "Install"
msgstr "התקנה"

msgid "Ready to install"
msgstr "מוכן להתקנה"

msgid "Check what will be installed."
msgstr "בדקו מה עומד להיות מותקן."

msgid "Package name on this system"
msgstr "שם החבילה במערכת הזו"

msgid "Package size"
msgstr "גודל החבילה"

msgid "Applications menu"
msgstr "תפריט היישומים"

msgid "No menu entry"
msgstr "אין פריט בתפריט"

msgid "Warnings"
msgstr "אזהרות"

msgid "Notes"
msgstr "הערות"

msgid "Dependencies"
msgstr "תלויות"

msgid "Required"
msgstr "נדרשות"

msgid "{n} package"
msgid_plural "{n} packages"
msgstr[0] "{n} חבילה"
msgstr[1] "{n} חבילות"

msgid "will be downloaded"
msgstr "יורדו"

msgid "Optional"
msgstr "אופציונליות"

msgid "Scripts"
msgstr "סקריפטים"

msgid "These commands from the Debian package run as administrator during installation."
msgstr "הפקודות האלה מחבילת Debian רצות כמנהל במהלך ההתקנה."

msgid "Open {name}"
msgstr "פתיחת {name}"

msgid "Copy details"
msgstr "העתקת הפרטים"

msgid "Close"
msgstr "סגירה"

msgid "This file cannot be installed"
msgstr "לא ניתן להתקין את הקובץ הזה"

msgid "Choose a .deb file"
msgstr "בחירת קובץ .deb"

msgid "Debian packages"
msgstr "חבילות Debian"

msgid "Type your password in the window that will appear."
msgstr "הקלידו את הסיסמה בחלון שיופיע."

msgid "Missing dependencies are downloaded from the repositories."
msgstr "תלויות חסרות מורדות מהמאגרים."

msgid "Compressing the files, this may take a minute."
msgstr "דוחס את הקבצים, זה עשוי לקחת דקה."

msgid "The package could not be converted"
msgstr "לא ניתן היה להמיר את החבילה"

msgid "Cancelled"
msgstr "בוטל"

msgid "{name} is installed"
msgstr "{name} מותקנת"

msgid "The package {name} was installed. It has no entry in the applications menu."
msgstr "החבילה {name} הותקנה. אין לה פריט בתפריט היישומים."

msgid "Installation complete"
msgstr "ההתקנה הושלמה"

msgid "Authorization was not granted"
msgstr "ההרשאה לא ניתנה"

msgid "The installation failed"
msgstr "ההתקנה נכשלה"

msgid "pacman returned an error (code {code}). Open the details to see what happened."
msgstr "pacman החזיר שגיאה (קוד {code}). פתחו את הפרטים כדי לראות מה קרה."

msgid "The application could not be started"
msgstr "לא ניתן היה להפעיל את היישום"

msgid "Copied"
msgstr "הועתק"

msgid "Please wait until the installation finishes"
msgstr "אנא המתינו עד לסיום ההתקנה"

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg לא יכול לרוץ כ-root; הריצו את debtap-mod כמשתמש רגיל."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg נכשל עם קוד יציאה {code}"

msgid "makepkg finished but produced no package"
msgstr "makepkg הסתיים אך לא יצר חבילה"

msgid "The Debian scripts only register an APT repository and an AppArmor profile for Ubuntu; they are not needed here."
msgstr "סקריפטי Debian רק רושמים מאגר APT ופרופיל AppArmor עבור Ubuntu; הם אינם נחוצים כאן."

msgid "The {script} script configures an APT repository; that part has no effect on this system."
msgstr "הסקריפט {script} מגדיר מאגר APT; לחלק הזה אין השפעה על המערכת הזו."
