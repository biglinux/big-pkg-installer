msgstr "חבילה זו נבנתה עבור ארכיטקטורת {deb_arch}, אך המערכת שלכם היא {host}."

msgid "Package"
msgstr "חבילה"

msgid "Package architecture"
msgstr "ארכיטקטורת החבילה"

msgid "System architecture"
msgstr "ארכיטקטורת המערכת"

msgid "This package cannot be installed on this computer. Look for a version of the package made for {host}."
msgstr "לא ניתן להתקין חבילה זו במחשב הזה. חפשו גרסה של החבילה שנבנתה עבור {host}."

msgid "This file cannot be installed"
msgstr "לא ניתן להתקין את הקובץ הזה"

msgid "The file may be damaged or is not a valid package. Download it again or check where it came from."
msgstr "ייתכן שהקובץ פגום או שאינו חבילה תקינה. הורידו אותו שוב או בדקו מאין הגיע."

msgid "Invalid file"
msgstr "קובץ לא תקין"

msgid "The selected file is not a .deb or .rpm package."
msgstr "הקובץ שנבחר אינו חבילת .deb או .rpm."

msgid "This installer works only with .deb and .rpm files (packages for Debian, Ubuntu, Fedora, openSUSE and their derivatives)."
msgstr "מתקין זה פועל רק עם קובצי .deb ו-.rpm (חבילות עבור Debian, Ubuntu, Fedora, openSUSE והנגזרות שלהן)."

