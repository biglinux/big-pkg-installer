msgstr "Sovellusta ei voitu käynnistää"

msgid "The RPM package is truncated or corrupted."
msgstr "RPM-paketti on katkennut tai vioittunut."

msgid "makepkg cannot run as root; run debtap-mod as a regular user."
msgstr "makepkg ei voi toimia root-käyttäjänä; suorita debtap-mod tavallisena käyttäjänä."

msgid "makepkg failed with exit code {code}"
msgstr "makepkg epäonnistui poistumiskoodilla {code}"

msgid "makepkg finished but produced no package"
msgstr "makepkg valmistui, mutta ei tuottanut pakettia"

msgid "“{typed}” only refreshes the package list. Here the safe equivalent checks for updates without installing anything; to install them use “{upgrade}”."
msgstr "“{typed}” vain päivittää pakettiluettelon. Tässä turvallinen vastine tarkistaa päivitykset asentamatta mitään; asenna ne komennolla “{upgrade}”."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Älä koskaan suorita pelkkää “pacman -Sy”: luettelon päivittäminen ilman järjestelmän päivittämistä voi rikkoa järjestelmän."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch ei päivitä yksittäisiä paketteja; koko järjestelmä päivitetään yhdessä."

msgid "Tell which package to install, for example: {example}"
msgstr "Kerro, mikä paketti asennetaan, esimerkiksi: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac löytää ohjelmia myös AUR:sta ja Flatpakista: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by debtap-mod."
msgstr "debtap-mod muuntaa .deb- ja .rpm-paketit natiiveiksi pacman-paketeiksi."

msgid "Run this command as a regular user (without sudo)."
msgstr "Suorita tämä komento tavallisena käyttäjänä (ilman sudoa)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Kerro, mikä paketti poistetaan, esimerkiksi: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n poistaa myös ne asetustiedostot, jotka paketti asensi hakemistoon /etc."

msgid "There are no orphan packages to remove."
msgstr "Poistettavia orporaketteja ei ole."

msgid "Tell what to search for, for example: {example}"
msgstr "Kerro, mitä etsitään, esimerkiksi: {example}"

msgid "Tell which package, for example: {example}"
msgstr "Kerro, mikä paketti, esimerkiksi: {example}"

msgid "The package is not installed; the list comes from the repository file database."
msgstr "Pakettia ei ole asennettu; luettelo tulee ohjelmistovaraston tiedostotietokannasta."

msgid "Tell which file, for example: {example}"
msgstr "Kerro, mikä tiedosto, esimerkiksi: {example}"

msgid "The file is not on this system; searching the repository file database."
msgstr "Tiedostoa ei ole tässä järjestelmässä; haetaan ohjelmistovaraston tiedostotietokannasta."

msgid "Arch-based systems have no PPAs or extra repositories to add. Programs from the community come from the AUR."
msgstr "Archiin perustuvissa järjestelmissä ei ole PPA-lähteitä eikä lisättäviä ohjelmistovarastoja. Yhteisön ohjelmat tulevat AUR:sta."

msgid "Search with “pamac search --aur <name>” and install with “pamac build <name>”."
msgstr "Hae komennolla “pamac search --aur <name>” ja asenna komennolla “pamac build <name>”."

msgid "To keep a package from being upgraded, add it to IgnorePkg in /etc/pacman.conf."
msgstr "Estä paketin päivittäminen lisäämällä se IgnorePkg-asetukseen tiedostossa /etc/pacman.conf."

msgid "“{command}” has no direct equivalent here."
msgstr "Komennolla “{command}” ei ole tässä suoraa vastinetta."

msgid "Run “{tool} help” to see the commands this system understands."
msgstr "Suorita “{tool} help” nähdäksesi komennot, jotka tämä järjestelmä ymmärtää."

msgid "Tell which .deb file to install, for example: {example}"
msgstr "Kerro, mikä .deb-tiedosto asennetaan, esimerkiksi: {example}"

