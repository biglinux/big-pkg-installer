msgstr "Ejecute “{tool} help” para ver todos los comandos."

msgid "What you want to do"
msgstr "Qué quiere hacer"

msgid "Differences that catch people"
msgstr "Diferencias que sorprenden"

msgid "apt update only refreshes the list; apt upgrade installs."
msgstr "apt update solo actualiza la lista; apt upgrade instala."

msgid "In pacman, -Syu does both together."
msgstr "En pacman, -Syu hace ambas cosas a la vez."

msgid "Avoid “pacman -Sy” alone: it can break the system."
msgstr "Evite “pacman -Sy” solo: puede romper el sistema."

msgid "Package types"
msgstr "Tipos de paquete"

msgid "apt uses .deb files, dnf uses .rpm, pacman uses .pkg.tar.zst."
msgstr "apt usa archivos .deb, dnf usa .rpm, pacman usa .pkg.tar.zst."

msgid ".deb and .rpm files are converted and installed with big-pkg-installer (or a double click)."
msgstr "Los archivos .deb y .rpm se convierten e instalan con big-pkg-installer (o con doble clic)."

msgid "Programs from the community"
msgstr "Programas de la comunidad"

msgid "The AUR plays the role of PPAs and COPR."
msgstr "El AUR hace el papel de los PPAs y COPR."

msgid "Use “pamac build <name>”; never run AUR helpers with sudo."
msgstr "Use “pamac build <name>”; nunca ejecute ayudantes del AUR con sudo."

msgid "Tip: “{tool} help install” shows only the lines about one command."
msgstr "Consejo: “{tool} help install” muestra solo las líneas de un comando."

msgid "Quick reference: “sudo” is needed to install or remove; searching and listing are not."
msgstr "Referencia rápida: se necesita “sudo” para instalar o eliminar; buscar y listar no lo requieren."

msgid "Command not found: {cmd}"
msgstr "Comando no encontrado: {cmd}"

