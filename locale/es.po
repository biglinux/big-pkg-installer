msgstr "Ambos hacen el mismo trabajo: instalar, actualizar y eliminar programas. Solo cambian los comandos."

msgid "You can keep typing {tool} commands: they are translated and run with pamac or pacman."
msgstr "Puede seguir escribiendo comandos de {tool}: se traducen y se ejecutan con pamac o pacman."

msgid "No command matches “{topic}”."
msgstr "Ningún comando coincide con “{topic}”."

