msgstr "“{typed}” solo actualiza la lista de paquetes. Aquí el equivalente seguro busca actualizaciones sin instalar nada; para instalarlas use “{upgrade}”."

msgid "Never run “pacman -Sy” alone: refreshing without upgrading can break the system."
msgstr "Nunca ejecute “pacman -Sy” solo: actualizar la lista sin actualizar el sistema puede romperlo."

msgid "Arch does not upgrade single packages; the whole system is upgraded together."
msgstr "Arch no actualiza paquetes sueltos; todo el sistema se actualiza en conjunto."

msgid "Tell which package to install, for example: {example}"
msgstr "Indique qué paquete instalar, por ejemplo: {example}"

msgid "pamac also finds programs in the AUR and Flatpak: {cmd}"
msgstr "pamac también encuentra programas en el AUR y en Flatpak: {cmd}"

msgid ".deb and .rpm packages are converted into native pacman packages by big-pkg-installer."
msgstr "big-pkg-installer convierte los paquetes .deb y .rpm en paquetes nativos de pacman."

msgid "Run this command as a regular user (without sudo)."
msgstr "Ejecute este comando como usuario normal (sin sudo)."

msgid "Tell which package to remove, for example: {example}"
msgstr "Indique qué paquete eliminar, por ejemplo: {example}"

msgid "-n also deletes the configuration files the package installed in /etc."
msgstr "-n también borra los archivos de configuración que el paquete instaló en /etc."

msgid "There are no orphan packages to remove."
